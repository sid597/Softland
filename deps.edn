{:paths     ["src" "resources"]
 :mvn/repos {"nexus-releases" {:url "https://nexus.redplanetlabs.com/repository/maven-public-releases"}}
 :deps      {ring/ring                          {:mvn/version "1.11.0"} ; comes with Jetty
             missionary/missionary              {:mvn/version "b.46"}

             com.google.guava/guava            {:mvn/version "33.1.0-jre"}
             org.clojure/data.xml               {:mvn/version "0.2.0-alpha8"}
             org.clojure/data.json              {:mvn/version "2.4.0"}
             org.clojure/clojure                {:mvn/version "1.12.4"}
             org.clojure/clojurescript          {:mvn/version "1.11.132"}
             org.clojure/tools.logging          {:mvn/version "1.2.4"}
             ch.qos.logback/logback-classic     {:mvn/version "1.2.11"}
             org.babashka/sci                  {:mvn/version "0.8.43"}
             com.rpl/rama                       {:mvn/version "1.6.0"}
             com.roamresearch/backend-sdk       {:mvn/version "0.0.4"}
             com.rpl/rama-helpers               {:mvn/version "0.10.0"}
             com.rpl/specter                    {:mvn/version "1.1.4"}
             clj-http/clj-http                  {:mvn/version "3.12.3"}
             org.apache.logging.log4j/log4j-slf4j2-impl {:mvn/version "2.23.1"}
             rewrite-clj/rewrite-clj {:mvn/version "1.1.47"}
             clj-kondo/clj-kondo {:mvn/version "2025.06.05"}}

             
 
 :aliases  {:inland {:extra-paths ["src-inland" "test-inland" "src/proposal/rig-2026-09-25/src"]
                       :jvm-opts ["-Xss16m" "-Xmx2g"]
                       :extra-deps {com.hyperfiddle/electric {:mvn/version "v3-alpha-20260519.115706-45"}
                                    thheller/shadow-cljs {:mvn/version "2.28.23"}}}
            ; The store: its own classpath. :replace-paths keeps the root src and
            ; resources off it, so a require of app code from the store fails at load.
            ; :replace-deps keeps the root's dependencies off it: Clojure alone.
            ;   clojure -M:store -m softland.store.act-proof
            :store {:replace-paths ["src-store" "test-store"]
                    :replace-deps {org.clojure/clojure {:mvn/version "1.12.4"}}
                    :jvm-opts ["-Xss16m" "-Xmx4g"]}
            ; The store's Rama module: the store's paths, Clojure and Rama, and
            ; nothing else of the root. A whole alias, not an addition to :store,
            ; so that :store still proves the pure code with Clojure alone.
            ; -Xss16m is for Rama's module compilation, as for :test below.
            ;   clojure -M:store-module -m softland.store.module-proof
            :store-module {:replace-paths ["src-store" "test-store"]
                           :replace-deps {org.clojure/clojure {:mvn/version "1.12.4"}
                                          com.rpl/rama {:mvn/version "1.6.0"}}
                           :jvm-opts ["-Xss16m" "-Xmx4g"]}
            ; The runtime: sign-in, in front of the store's door and read path.
            ; The store's paths and the runtime's, Clojure, and Nimbus for the
            ; check of Google's ID token; nothing else of the root.
            ;   clojure -M:runtime -m softland.runtime.pure-proof
            :runtime {:replace-paths ["src-store" "src-runtime" "test-runtime"]
                      :replace-deps {org.clojure/clojure {:mvn/version "1.12.4"}
                                     com.nimbusds/nimbus-jose-jwt {:mvn/version "10.10"}}
                      :jvm-opts ["-Xss16m" "-Xmx4g"]}
            ; The runtime on a cluster: the same paths, Clojure, Rama and Nimbus.
            ; A whole alias, as :store-module is, so that :runtime still proves
            ; the pure code without Rama.
            :runtime-module {:replace-paths ["src-store" "src-runtime" "test-runtime"]
                             :replace-deps {org.clojure/clojure {:mvn/version "1.12.4"}
                                            com.rpl/rama {:mvn/version "1.6.0"}
                                            com.nimbusds/nimbus-jose-jwt {:mvn/version "10.10"}}
                             :jvm-opts ["-Xss16m" "-Xmx4g"]}
            :dev   {:extra-paths ["src-dev" "test"]
                    :extra-deps {io.github.clojure/tools.build {:mvn/version "0.9.6"
                                                                 :exclusions  [com.google.guava/guava  ; Guava version conflict between tools.build and clojurescript.
                                                                               org.slf4j/slf4j-nop]}   ; clashes with app logger}
                                 thheller/shadow-cljs            {:mvn/version "2.28.23"}}}

            :nrepl {:extra-deps
                    {cider/cider-nrepl {:mvn/version "0.42.1"}
                     nrepl/nrepl       {:mvn/version "1.0.0"}}
                    :main-opts
                    ["-m" "nrepl.cmdline"
                     "--middleware" "[cider.nrepl/cider-middleware]"
                     "--interactive"
                     "--port" "9001"]}

            ; -Xss: Rama's module compilation analyzes topology graphs
            ; recursively; loading the llm + space dogfood modules in one JVM
            ; overflows the default thread stack during that analysis.
            :test {:extra-paths ["test"]
                   :jvm-opts ["-Xss16m"]
                   :ns-default app.test-runner
                   :exec-fn app.test-runner/full}

            :prod {:extra-paths ["src-prod"]}

            :build {:extra-paths ["src-build"]
                    :ns-default build
                    :extra-deps {io.github.clojure/tools.build {:mvn/version "0.9.6"
                                                                 :exclusions  [com.google.guava/guava  ; Guava version conflict between tools.build and clojurescript.
                                                                               org.slf4j/slf4j-nop]}   ; clashes with app logger}
                                 }}}}
