+(deftest studio-gate-schema-is-closed-and-candidate-set-bound
+  (let [instances [{:instance/id "du:empty" :instance/shape :empty}
+                   {:instance/id "du:wrapped"
+                    :instance/shape :wrapped-multiline}
+                   {:instance/id "du:marks"
+                    :instance/shape :marks-or-machine}]
+        marker (studio/marker-form
+                {:master-id anatomy/master-id
+                 :candidate-revision-id "rev:candidate"
+                 :candidate-content-sha256 "sha"
+                 :expected-instances instances
+                 :report nil})
+        rows (fn [kind ids]
+               (mapv (fn [id]
+                       {(keyword (name kind) "id") id
+                        (keyword (name kind) "result") :pass
+                        (keyword (name kind) "receipt") {:observed true}})
+                     (sort-by str ids)))
+        report (studio/report-form
+                {:id "report"
+                 :master-id anatomy/master-id
+                 :candidate-revision-id "rev:candidate"
+                 :candidate-content-sha256 "sha"
