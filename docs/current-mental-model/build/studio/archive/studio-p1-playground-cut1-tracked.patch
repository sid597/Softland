+;; ===========================================================================
+;; Studio P1 — marker-first promotion and durable validation reports
+;;
+;; The gate is another ObjectContainer on the SAME master partition. It is not
+;; a new source family, depot, PState, or topology. Its existence is the
+;; canonical owner's non-caller-asserted discriminator: callers cannot opt a
+;; Studio candidate out of validation by omitting a flag or ground.
+;; ===========================================================================
+
+(defn studio-gate-container-id
+  [spec candidate-revision-id]
+  (oc/block-container-id
+   (master-id spec)
+   (str "studio-gate-" (core/sha-256 (str candidate-revision-id)))))
