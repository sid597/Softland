+                 :checks (rows :check studio/check-ids)
+                 :flows (rows :flow studio/flow-ids)
+                 :result :pass
+                 :actor {:actor/id "agent" :actor/type :agent}
+                 :time-ms 1
+                 :request-id "request"})]
+    (is (studio/valid-marker? marker))
+    (is (studio/valid-report? report marker))
+    (is (some #(= :studio-report/keys-invalid (:type %))
+              (studio/report-errors (assoc report :unexpected true) marker)))
+    (is (some #(= :studio-report/instance-set-mismatch (:type %))
+              (studio/report-errors
+               (assoc-in report [:studio-report/tested-instances 0
+                                 :instance/id]
+                         "du:different")
+               marker)))
+    (is (some #(= :studio-report/pass-rows-not-all-pass (:type %))
+              (studio/report-errors
+               (assoc-in report [:studio-report/flows 0 :flow/result] :fail)
+               marker)))))
