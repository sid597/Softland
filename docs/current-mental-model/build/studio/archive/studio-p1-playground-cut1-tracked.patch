+(defn- report-semantic-equal?
+  [a b]
+  (= (dissoc a :studio-report/request-id)
+     (dissoc b :studio-report/request-id)))
+
+(defn studio-report-request
+  "Construct one report edit against the current durable marker. Exact retry
+   reuses the original report's embedded audit request id while the outer
+   request id may be fresh; changed bytes retain the deterministic report
+   idempotency key and are rejected by ObjectContainer conflict semantics."
+  [runtime spec candidate-revision-id report-data opts]
+  (let [gate (read-studio-gate runtime spec candidate-revision-id)
+        marker (:marker gate)
+        existing (:studio-gate/report marker)
+        request-id (or (:request/id opts)
+                       (:request-id opts)
+                       (core/random-id "studio-report-request"))
+        report-id (studio-report-id
+                   spec candidate-revision-id
+                   (:studio-gate/expected-instances marker))
+        actor (or (:actor report-data) (:actor opts)
+                  {:actor/id "studio-validator" :actor/type :agent})
+        time-ms (long (or (:time-ms report-data)
+                          (:time-ms opts)
+                          (core/now-ms)))
+        proposed (studio/report-form
+                  {:id report-id
+                   :master-id (master-id spec)
+                   :candidate-revision-id candidate-revision-id
+                   :candidate-content-sha256
+                   (:studio-gate/candidate-content-sha256 marker)
+                   :tested-instances (:tested-instances report-data)
+                   :checks (:checks report-data)
+                   :flows (:flows report-data)
+                   :result (:result report-data)
+                   :actor actor
+                   :time-ms time-ms
+                   :request-id request-id})
+        report (if (and (map? existing)
+                        (report-semantic-equal? existing proposed))
+                 existing
+                 proposed)
+        marker' (when (map? marker)
+                  (assoc marker :studio-gate/report report))
+        content (when marker' (studio/canonical-source marker'))
+        gate-id (:container-id gate)]
+    (if (or (not (:required? gate))
+            (seq (:errors gate))
+            (seq (studio/report-errors report marker)))
+      {:request nil
+       :report report
+       :accepted? false
+       :reason :studio/report-refused
+       :errors (vec (concat (:errors gate)
+                            (studio/report-errors report marker)))}
+      (oc/object-edit-request
+       :object-container gate-id content
+       {:object/key (master-id spec)
+        :document/container-id (document-id spec)
+        :request/id request-id
+        :time-ms time-ms
+        :revision/id
+        (str "rev:" (master-id spec) ":studio-report:"
+             (core/sha-256 request-id))
+        :edit/client-id (str "studio-validator:" report-id)
+        :edit/seq 1
+        :edit/lineage-key gate-id
+        :idempotency/key (str "studio/report:" report-id)
+        :actor (normalize-actor actor activation-capabilities)
+        :provenance {:source/type :studio-validation
+                     :source/ref report-id}}))))
+
+(defn submit-studio-report!
+  [runtime spec candidate-revision-id report-data opts]
+  (let [request (studio-report-request runtime spec candidate-revision-id
+                                       report-data opts)]
+    (if (not= :object/edit (:request/type request))
+      request
+      (let [{:keys [decision replay?]} (append-and-read! runtime request)
+            accepted? (oc/decision-accepted? decision)
+            gate (read-studio-gate runtime spec candidate-revision-id)]
+        {:request request
+         :decision decision
+         :accepted? accepted?
+         ;; ObjectContainer records a fresh audit decision when a fresh
+         ;; request id reuses an identical report idempotency key. That is a
+         ;; semantic replay even though `append-and-read!` could not see this
+         ;; particular audit id before the append.
+         :replay? (or replay?
+                      (some? (:replayed-from-decision-id decision)))
+         :report (get-in gate [:marker :studio-gate/report])
+         :errors (vec (:errors gate))}))))
+
+(def ^:private studio-gate-history-page-limit
+  "R1b · TRAP-2/TRAP-7 — the canonical guard must read EVERY historical
+   revision of a gate container before trusting the current one alone; a
+   marker imported directly at the runtime (bypassing
+   `studio-promote-candidate!`'s R1a pre-append guard) still supersedes the
+   container's current pointer without this. A full page proves nothing was
+   left unread; a full page fails CLOSED rather than guessing what's beyond
+   it (mirrors `activation-trail`'s `trail-page-limit`, but this reads a gate
+   container rather than an active-pointer container)."
+  1000)
+
+(defn- studio-gate-history-terminal-errors
+  "Every historical revision of the SAME gate container, compared against the
+   CURRENT marker/report. The container id is keyed on the candidate revision
+   ALONE (`studio-gate-container-id`), so a second import — whether through
+   `studio-promote-candidate!` or straight at the runtime — lands on this
+   SAME container; reading only the current revision cannot see it. TRAP-7:
+   the first durable report for a candidate revision is terminal — it is
+   never rewritten into a PASS by minting a fresh marker on top of it, the
+   same way a revision is never relabeled across containers. The current
+   revision naturally appears in this history and compares equal to itself,
+   so it never self-conflicts. Fails CLOSED: an unparseable row, or a page so
+   full more history might be hiding beyond it, refuses rather than guesses."
+  [runtime gate-id current-marker current-report]
+  (let [rows (ocr/read-revision-history
+              runtime gate-id "" studio-gate-history-page-limit)]
+    (cond
+      (>= (count rows) studio-gate-history-page-limit)
+      [{:type :studio-gate/history-incomplete}]
+
+      :else
+      (let [parsed (mapv (fn [row]
+                            (try
+                              {:ok? true
+                               :marker (edn/read-string (:content-text row))}
+                              (catch Throwable _ {:ok? false})))
+                          rows)]
+        (if (some (complement :ok?) parsed)
+          [{:type :studio-gate/history-unreadable}]
+          (let [markers (mapv :marker parsed)
+                current-expected (:studio-gate/expected-instances current-marker)
+                current-report-id (:studio-report/id current-report)]
+            (vec
+             (concat
+              (when (some #(not= current-expected
+                                 (:studio-gate/expected-instances %))
+                          markers)
+                [{:type :studio-gate/marker-mutated}])
+              (when (some #(when-let [r (:studio-gate/report %)]
+                            (not= current-report-id (:studio-report/id r)))
+                          markers)
+                [{:type :studio-report/superseded}])
+              (when (some #(= :fail (:studio-report/result
+                                     (:studio-gate/report %)))
+                          markers)
+                [{:type :studio-report/failed-terminally}])))))))))
+
+(defn- studio-gate-evaluation
+  "Read every durable fact required before a Studio pointer may move. Any
+   read/parse/audit mismatch is a refusal; marker absence alone means this is
+   an existing non-Studio activation and preserves its behavior."
+  [runtime spec candidate]
+  (try
+    (let [revision-id (:revision-id candidate)
+          candidate-sha (:content-hash candidate)
+          gate (read-studio-gate runtime spec revision-id)]
+      (if-not (:required? gate)
+        {:required? false :errors []}
+        (let [marker (:marker gate)
+              report (:studio-gate/report marker)
+              report-id (when (map? marker)
+                          (studio-report-id
+                           spec revision-id
+                           (:studio-gate/expected-instances marker)))
+              report-request-id (:studio-report/request-id report)
+              audit (when (string? report-request-id)
+                      (ocr/read-request runtime (master-id spec)
+                                        report-request-id))
+              raw (:raw-request audit)
+              decision (when (string? report-request-id)
+                         (ocr/read-decision runtime (master-id spec)
+                                            report-request-id))
+              ;; R1b · TRAP-2/TRAP-7 — the CURRENT revision alone is not
+              ;; enough: see `studio-gate-history-terminal-errors`.
+              history-errors
+              (studio-gate-history-terminal-errors
+               runtime (:container-id gate) marker report)
+              errors
+              (cond-> (vec (concat (:errors gate) history-errors))
+                (and (map? marker)
+                     (not= (master-id spec)
+                           (:studio-gate/master-id marker)))
+                (conj {:type :studio-gate/master-mismatch})
+
+                (and (map? marker)
+                     (not= revision-id
+                           (:studio-gate/candidate-revision-id marker)))
+                (conj {:type :studio-gate/candidate-mismatch})
+
+                (and (map? marker)
+                     (not= candidate-sha
+                           (:studio-gate/candidate-content-sha256 marker)))
+                (conj {:type :studio-gate/content-mismatch})
+
+                (nil? report)
+                (conj {:type :studio-report/missing})
+
+                (map? report)
+                (into (studio/report-errors report marker))
+
+                (and (map? report)
+                     (not= :pass (:studio-report/result report)))
+                (conj {:type :studio-report/not-passing})
+
+                (and (map? report)
+                     (not= report-id (:studio-report/id report)))
+                (conj {:type :studio-report/id-mismatch})
+
+                (nil? audit)
+                (conj {:type :studio-report/audit-request-missing})
+
+                (and raw (not= :object/edit (:request/type raw)))
+                (conj {:type :studio-report/audit-request-type-invalid})
+
+                (and raw (not= (:container-id gate)
+                               (get-in raw [:target :target/id])))
+                (conj {:type :studio-report/audit-target-mismatch})
+
+                (and raw
+                     (not= (:content-hash (:revision gate))
+                           (get-in raw [:payload :content-hash])))
+                (conj {:type :studio-report/audit-content-mismatch})
+
+                (and raw
+                     (not= (str "studio/report:" report-id)
+                           (:idempotency/key raw)))
+                (conj {:type :studio-report/audit-idempotency-mismatch})
+
+                (and raw report
+                     (not= (:studio-report/actor report)
+                           (select-keys (:actor raw)
+                                        [:actor/id :actor/type])))
+                (conj {:type :studio-report/audit-actor-mismatch})
+
+                (and raw report
+                     (not= (:studio-report/time-ms report)
+                           (:request/time-ms raw)))
+                (conj {:type :studio-report/audit-time-mismatch})
+
+                (not (oc/decision-accepted? decision))
+                (conj {:type :studio-report/decision-not-accepted}))]
+          {:required? true
+           :container-id (:container-id gate)
+           :marker marker
+           :report report
+           :report-id report-id
+           :errors errors})))
+    (catch Throwable t
+      {:required? true
+       :errors [{:type :studio-gate/read-failed
+                 :message (.getMessage t)}]})))
+
