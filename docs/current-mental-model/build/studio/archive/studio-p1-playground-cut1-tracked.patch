+(deftest studio-refused-write-reverts-preview-to-acked-source-or-clears-it
+  "R3 — settle-draft-candidate!/persist-draft!/land-empty-draft! install a
+   candidate into the preview BEFORE their durable write lands. On refusal the
+   preview must never keep showing material that does not durably exist:
+   revert to the last DURABLY acked source, or clear entirely when nothing
+   has ever been acked."
+  (studio-ui/reset-state!)
+  (try
+    (let [subject "du:r3-refusal"
+          rect (studio-ui/gesture-rect [[100 80] [30 20]])
+          draft (studio-ui/new-draft-candidate anatomy/default-form rect)
+          retuned-a (studio-ui/retune-candidate
+                     (:form draft) [0.30 0.70 0.95 1.0])
+          retuned-b (studio-ui/retune-candidate
+                     (:form draft) [0.94 0.55 0.28 1.0])
+          base {:anatomy (facet-material/code-floor anatomy/spec)}]
+      (is (= :candidate (:status retuned-a)))
+      (is (= :candidate (:status retuned-b)))
+      (is (not= (:source retuned-a) (:source retuned-b)))
+
+      (testing "a still-born draft (never acked) clears entirely on refusal"
+        (studio-ui/record-draft! subject (:source draft) (:form draft))
+        (is (= (:source draft)
+               (get-in (studio-ui/state) [:preview-by-subject subject])))
+        (studio-ui/revert-preview-on-refusal! subject)
+        (is (nil? (get-in (studio-ui/state) [:preview-by-subject subject])))
+        (is (identical? base (studio-ui/wears-for subject base))
+            "no preview left means the subject wears its normal material"))
+
+      (testing "an acked source survives a LATER optimistic edit and is the
+                fallback on that edit's refusal"
+        (studio-ui/set-candidate! subject retuned-a)
+        (studio-ui/ack-draft-source! subject (:source retuned-a))
+        (is (= (:source retuned-a)
+               (get-in (studio-ui/state) [:drafts subject :acked-source])))
+
+        (studio-ui/set-candidate! subject retuned-b)
+        (is (= (:source retuned-b)
+               (get-in (studio-ui/state) [:preview-by-subject subject]))
+            "the optimistic write renders immediately")
+        (is (= (:source retuned-a)
+               (get-in (studio-ui/state) [:drafts subject :acked-source]))
+            "the prior accepted source survives the optimistic overwrite")
+
+        (studio-ui/revert-preview-on-refusal! subject)
+        (is (= (:source retuned-a)
+               (get-in (studio-ui/state) [:preview-by-subject subject]))
+            "refusal reverts to the last DURABLY acked source, never the refused one")
+        (is (not (identical? base (studio-ui/wears-for subject base)))
+            "the reverted preview is real acked material, not a clear")))
+    (finally (studio-ui/reset-state!))))
