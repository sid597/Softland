+                       (not (:valid? compiled)) (into (:errors compiled))
+                       (and (:valid? compiled) (studio/draft-form? form))
+                       (conj {:type :studio/candidate-still-draft})
+                       (not (studio/instance-set? expected))
+                       (conj {:type :studio-gate/expected-instances-invalid}))]
+    (if (seq input-errors)
+      {:accepted? false
+       :reason :studio/promotion-refused
+       :errors input-errors
+       :revision-id revision-id}
+      (let [;; A clean land may still serve this shared master from its code
+            ;; floor, with no durable pointer container yet. Reuse the
+            ;; existing bootstrap owner before marker-first Studio promotion;
+            ;; otherwise the later guarded object-edit has no target.
+            _ (when (nil? (:active-pointer (read-master runtime spec)))
+                (ensure-master! runtime spec))
+            prior-revision-id
+            (get-in (read-master runtime spec)
+                    [:active-revision :revision-id])
+            ;; R1a · TRAP-2 — `studio-gate-container-id` is keyed on
+            ;; `revision-id` ALONE, never on `expected`. Read the gate BEFORE
+            ;; minting anything: without this, re-promoting the SAME
+            ;; candidate under a DIFFERENT expected-instances vector mints
+            ;; DIFFERENT marker bytes -> a DIFFERENT import-key -> a fresh
+            ;; accepted import that supersedes the existing marker (and any
+            ;; durable report already recorded on it) on the SAME container.
+            existing-gate (read-studio-gate runtime spec revision-id)
+            proposed-marker (studio/marker-form
+                             {:master-id (master-id spec)
+                              :candidate-revision-id revision-id
+                              :candidate-content-sha256 content-sha
+                              :expected-instances expected
+                              :report nil})]
+        (cond
+          (and (:required? existing-gate)
+               (some? (get-in existing-gate [:marker :studio-gate/report])))
+          {:accepted? false
+           :reason :studio/gate-already-reported
+           :revision-id revision-id
+           :prior-revision-id prior-revision-id
+           :errors [{:type :studio-gate/report-exists}]}
+
+          (and (:required? existing-gate)
+               (not= proposed-marker (:marker existing-gate)))
+          {:accepted? false
+           :reason :studio/gate-marker-conflict
+           :revision-id revision-id
+           :prior-revision-id prior-revision-id
+           :errors (vec (concat (:errors existing-gate)
+                                [{:type :studio-gate/marker-conflict}]))}
+
+          :else
+          (let [marker-request
+                (studio-gate-import-request
+                 spec revision-id content-sha expected
+                 {:request/id (or (:marker-request/id opts)
+                                  (:marker-request-id opts))
+                  :time-ms (:time-ms opts)
+                  :actor (:actor opts)})
+                marker-result (append-and-read! runtime marker-request)
+                marker-accepted? (oc/decision-accepted? (:decision marker-result))
+                gate (when marker-accepted?
+                       (read-studio-gate runtime spec revision-id))]
+            (if-not (and marker-accepted?
+                         (:required? gate)
+                         (empty? (:errors gate))
+                         (= (:studio-gate/marker marker-request) (:marker gate)))
+              {:accepted? false
+               :reason :studio/gate-marker-refused
+               :errors (vec (concat (:errors gate)
+                                    (when-not marker-accepted?
+                                      [{:type :studio-gate/marker-decision-rejected
+                                        :decision (:decision marker-result)}])))
+               :marker {:request marker-request
+                        :decision (:decision marker-result)
+                        :replay? (:replay? marker-result)}
+               :prior-revision-id prior-revision-id
+               :revision-id revision-id}
+              (let [candidate
+                    (import-candidate!
+                     runtime spec source
+                     {:request/id (or (:candidate-request/id opts)
+                                      (:candidate-request-id opts)
+                                      (:request/id opts)
+                                      (:request-id opts))
+                      :time-ms (:time-ms opts)
+                      :actor (:actor opts)})]
+                {:accepted? (:accepted? candidate)
+                 :reason (when-not (:accepted? candidate)
+                           :studio/candidate-import-refused)
+                 :errors (vec (get-in candidate [:decision :errors]))
+                 :revision-id revision-id
+                 :prior-revision-id prior-revision-id
+                 :candidate-content-sha256 content-sha
+                 :expected-instances expected
+                 :marker {:request marker-request
+                          :decision (:decision marker-result)
+                          :replay? (:replay? marker-result)}
+                 :candidate candidate}))))))))
