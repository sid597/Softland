+(defn- read-studio-gate
+  [runtime spec candidate-revision-id]
+  (let [gate-id (studio-gate-container-id spec candidate-revision-id)
+        revision (ocr/read-current-revision runtime gate-id)]
+    (if-not revision
+      {:required? false :container-id gate-id}
+      (try
+        (let [marker (edn/read-string (:content-text revision))]
+          {:required? true
+           :container-id gate-id
+           :revision revision
+           :marker marker
+           :errors (studio/marker-errors marker)})
+        (catch Throwable t
+          {:required? true
+           :container-id gate-id
+           :revision revision
+           :marker nil
+           :errors [{:type :studio-gate/parse-error
+                     :message (.getMessage t)}]})))))
