+;; ===========================================================================
+;; Studio P1 — the ordinary canvas with the pencil out
+;; ===========================================================================
+
+(defn- upsert-studio-slot!
+  [vi tree {:keys [x y scale layer meta] :or {scale 1.0}}]
+  (if-let [slot (ss/slot (scene-rt/store-snapshot) vi)]
+    (do
+      (swap! scene-rt/!scene-store ss/upsert-slot vi
+             {:tree tree :container (:container slot)
+              :meta (:meta slot) :stratum (:stratum slot)
+              :pre-resolved? true})
+      (scene-rt/set-transform! (:container slot) {:x x :y y :scale scale}))
+    (scene-rt/register-face-instance!
+     vi tree {:x x :y y :scale scale :layer layer
+              :meta meta :pre-resolved? true})))
+
+(defn- render-studio-stroke! [rect]
+  (if rect
+    (upsert-studio-slot!
+     studio-ui/stroke-view-instance
+     (studio-ui/stroke-tree rect)
+     {:x (:x rect) :y (:y rect) :layer 8
+      :meta {:studio-stroke? true}})
+    (scene-rt/close-instance! studio-ui/stroke-view-instance)))
+
+(defn- render-studio!
+  []
+  ;; the entry handle is canvas furniture, not material: world-placed at the
+  ;; viewport's top-left with zoom cancelled (constant screen size), because
+  ;; pick inverse-transforms container+world only — a :camera :screen
+  ;; container would render fixed yet mis-pick under pan/zoom
+  (let [zoom (:zoom @!camera 1.0)
+        [hx hy] (screen->world 24 24)]
+    (upsert-studio-slot!
+     studio-ui/birth-view-instance (studio-ui/birth-handle-tree)
+     {:x hx :y hy :scale (/ 1.0 zoom) :layer 6
+      :meta {:studio-birth-handle? true}}))
+  (if-let [subject (studio-ui/selected)]
+    (if-let [block (get-in @!world [:blocks subject])]
+      (let [x (+ (:x block) (or (:w block) 240.0) 12.0)
+            y (:y block)
+            rx (+ (:x block) (or (:w block) 240.0) -9.0)
+            ry (+ (:y block) (or (:h block) 40.0) -9.0)]
+        (upsert-studio-slot!
+         studio-ui/controls-view-instance (studio-ui/controls-tree)
+         {:x x :y y :layer 8 :meta {:studio-controls? true :subject subject}})
+        (upsert-studio-slot!
+         studio-ui/resize-view-instance
+         (studio-ui/resize-handle-tree subject)
+         {:x rx :y ry :layer 8 :meta {:studio-resize? true :subject subject}}))
+      (do
+        (scene-rt/close-instance! studio-ui/controls-view-instance)
+        (scene-rt/close-instance! studio-ui/resize-view-instance)))
+    (do
+      (scene-rt/close-instance! studio-ui/controls-view-instance)
+      (scene-rt/close-instance! studio-ui/resize-view-instance))))
+
+(defn- read-edn-response [resp]
+  (.then (.text resp)
+         (fn [text]
+           (let [data (try (reader/read-string text)
+                           (catch :default _
+                             {:status :error :error :studio/unreadable-response}))]
+             (assoc data :http/ok? (.-ok resp))))))
+
+(defn- post-edn! [path body]
+  (-> (js/fetch path
+                (clj->js {:method "POST"
+                          :headers {"Content-Type" "application/edn"}
+                          :body (pr-str body)}))
+      (.then read-edn-response)))
+
+(defn- post-studio! [body]
+  (post-edn!
+   "/api/matter-room/deviate"
+   (merge {:request-id (str (random-uuid))
+           :time-ms (js/Date.now)
+           :actor {:actor/id "studio" :actor/type :human}}
+          body)))
+
+(defn- studio-refused! [label result]
+  ;; a human-readable :reason renders ON the canvas — the details door is for
+  ;; substrate EDN, never the only place the "why" lives (law 9's spirit; the
+  ;; halo/workshop failure was exactly a wall that would not say why)
+  (let [reason (:reason result)]
+    (studio-ui/set-status!
+     (if (string? reason)
+       (str label " could not finish — " reason)
+       (str label " could not finish"))
+     (dissoc result :card)))
+  (render-studio!)
+  result)
+
+(defn- studio-draft-refused!
+  "R3 — settle-draft-candidate!/persist-draft!/land-empty-draft! all install
+   the candidate into `:preview-by-subject` BEFORE their durable write lands.
+   On refusal the client must not keep rendering material that does not
+   durably exist: revert the subject's preview to its last acked source (or
+   clear it — a still-born draft) and rebuild the block BEFORE the generic
+   refusal status renders, so the canvas reflects truth first."
+  [label subject result]
+  (studio-ui/revert-preview-on-refusal! subject)
+  (rebuild-block! subject)
+  (studio-refused! label result))
+
+(defn- focus-draft!
+  ([subject text] (focus-draft! subject text 0))
+  ([subject text caret]
+   (let [old (:focus @!ground-edit)]
+     (swap! !ground-edit ge/focus-block subject (or text "") caret)
+     (when (and old (not= old subject)) (rebuild-block! old))
+     (rebuild-block! subject)
+     (refresh-anchor!))))
+
+(defn- settle-draft-candidate!
+  [op subject candidate]
+  ;; TRAP-6 — preview and persistence consume the SAME seven-op result. There
+  ;; is no Studio writer beside the grammar compiler.
+  (studio-ui/set-candidate! subject candidate)
+  (rebuild-block! subject)
+  (render-studio!)
+  (-> (post-studio! {:studio/op op :subject-uid subject
+                     :source (:source candidate)})
+      (.then
+       (fn [result]
+         (if (:accepted? result)
+           (do (studio-ui/ack-draft-source! subject (:source candidate))
+               (studio-ui/set-status! "Draft saved")
+               (render-studio!)
+               result)
+           (studio-draft-refused! "Saving the draft" subject result))))
+      (.catch
+       (fn [error]
+         (studio-draft-refused! "Saving the draft" subject
+                                {:error (.-message error)})))))
+
+(defn- persist-draft!
+  [subject candidate]
+  (-> (post-studio! {:studio/op :birth :subject-uid subject
+                     :source (:source candidate)})
+      (.then
+       (fn [result]
+         (if (:accepted? result)
+           (do (studio-ui/ack-draft-source! subject (:source candidate))
+               (studio-ui/set-status! "Draft is real and ready")
+               (render-studio!)
+               result)
+           (studio-draft-refused! "Making the draft real" subject result))))
+      (.catch
+       (fn [error]
+         (studio-draft-refused! "Making the draft real" subject
+                                {:error (.-message error)})))))
+
+(defn- land-draft!
+  [subject text candidate]
+  (studio-ui/record-draft! subject (:source candidate) (:form candidate))
+  (focus-draft! subject text)
+  (render-studio!)
+  (persist-draft! subject candidate))
+
+(def ^:private studio-empty-birth-seed
+  ;; The protected episode cut intentionally mints no unit for blank text.
+  ;; Route (a) still requires an ordinary durable block identity, so Studio
+  ;; births one invisible codepoint and immediately removes it through the
+  ;; existing block-edit envelope. The surviving block truth is byte-empty;
+  ;; no episode/kernel branch or second writer is introduced.
+  "​")
+
+(defn- land-empty-draft!
+  [subject candidate]
+  (studio-ui/record-draft! subject (:source candidate) (:form candidate))
+  (focus-draft! subject studio-empty-birth-seed
+                (count studio-empty-birth-seed))
+  (let [{:keys [state envelope]}
+        (ge/input @!ground-edit {:type :backspace}
+                  (block-info subject) (object-key*))]
+    (reset! !ground-edit state)
+    (rebuild-block! subject)
+    (render-studio!)
+    (if envelope
+      (submit-envelope!
+       envelope
+       (fn [decision]
+         (if (= :accepted (:status decision))
+           (persist-draft! subject candidate)
+           (studio-draft-refused! "Making the blank draft real" subject
+                                  decision))))
+      (studio-draft-refused! "Making the blank draft real" subject
+                             {:error :studio/blank-normalization-unavailable}))))
+
+(defn- birth-studio-draft! [rect]
+  (let [candidate
+        (studio-ui/new-draft-candidate
+         (anatomy-material/form-for-wear
+          (:anatomy (current-material-wears)))
+         rect)]
+    (if-not (= :candidate (:status candidate))
+      (studio-refused! "Drawing the draft" candidate)
+      (post-birth!
+       {:block-id (str (random-uuid))
+        :text studio-empty-birth-seed
+        :pos {:x (:x rect) :y (:y rect)}
+        :on-acked
+        (fn [subject _data]
+          (land-empty-draft! subject candidate))}))))
+
+(defn- schedule-stroke-receipt! [started-at-ms]
+  (js/requestAnimationFrame
+   (fn [_frame-start-ms]
+     ;; A RAF callback's supplied timestamp is the frame start and may be
+     ;; slightly older than a performance.now sampled later in that frame.
+     ;; Sample the same monotonic clock here so the echo receipt cannot report
+     ;; an impossible negative duration.
+     (studio-ui/note-painted! started-at-ms (js/performance.now)))))
+
+(defn- begin-studio-gesture!
+  [intent subject origin world]
+  (let [started-at-ms (js/performance.now)]
+    (studio-ui/begin-gesture! intent subject origin started-at-ms)
+    (let [rect (studio-ui/move-gesture! world)]
+      (render-studio-stroke! rect)
+      (schedule-stroke-receipt! started-at-ms))))
+
+(defn- move-studio-gesture! [world]
+  (let [started-at-ms (js/performance.now)
+        rect (studio-ui/move-gesture! world)]
+    (render-studio-stroke! rect)
+    (schedule-stroke-receipt! started-at-ms)))
+
+(defn- end-studio-gesture! [world]
+  (let [{:keys [intent subject rect]} (studio-ui/finish-gesture! world)]
+    (render-studio-stroke! nil)
+    (case intent
+      :resize
+      (when-let [form (:form (studio-ui/draft subject))]
+        (settle-draft-candidate!
+         :settle subject (studio-ui/resize-candidate form rect)))
+
+      :birth
+      (birth-studio-draft! rect)
+      nil)))
+
+(defn- studio-birth-action!
+  [_descriptor {:keys [continuation press world]}]
+  (case continuation
+    :begin (begin-studio-gesture! :birth nil (:press/world press) world)
+    :move (move-studio-gesture! world)
+    :end (end-studio-gesture! world)
+    nil)
+  true)
+
+(defn- studio-resize-action!
+  [{:keys [studio/subject]} {:keys [continuation press world]}]
+  (let [block (get-in @!world [:blocks subject])
+        origin (when block [(:x block) (:y block)])]
+    (case continuation
+      :begin (when origin
+               (begin-studio-gesture! :resize subject origin world))
+      :move (move-studio-gesture! world)
+      :end (end-studio-gesture! world)
+      nil))
+  true)
+
+(defn- studio-instance-shape [block text]
+  (cond
+    (or (:machine? block)
+        (seq (get-in @!world
+                     [:context :conversation/experience
+                      :experience/gold-marks-by-target (:id block)]))
+        (seq (get-in @!world
+                     [:context :conversation/experience
+                      :experience/silver-marks-by-target (:id block)])))
+    :marks-or-machine
+
+    (str/blank? (or text "")) :empty
+
+    (or (str/includes? (or text "") "\n")
+        (> (count (or text "")) (long (or (:wrap-col block) 80))))
+    :wrapped-multiline
+    :else nil))
+
+(defn- validation-instances []
+  (let [rows (->> (:blocks @!world)
+                  (map (fn [[id block]]
+                         (assoc block :id id :text (or (truth-text id) "")
+                                :shape (studio-instance-shape
+                                        (assoc block :id id)
+                                        (or (truth-text id) "")))))
+                  (filter :shape)
+                  vec)
+        picked (mapv (fn [shape]
+                       (some #(when (= shape (:shape %)) %) rows))
+                     [:empty :wrapped-multiline :marks-or-machine])]
+    (when (and (every? some? picked)
+               (= 3 (count (set (map :id picked)))))
+      (mapv (fn [row]
+              {:instance/id (:id row) :instance/shape (:shape row)})
+            picked))))
+
+(defn- result-row [kind id pass? receipt]
+  {(keyword (name kind) "id") id
+   (keyword (name kind) "result") (if pass? :pass :fail)
+   (keyword (name kind) "receipt") receipt})
+
+(defn- focus-binding-row [subject]
+  (some (fn [row]
+          (when (= :focus/place-caret
+                   (get-in row [:binding/verb :verb/name]))
+            row))
+        (get-in (wears-for subject)
+                [:attention :facet-master/bindings :block/user-hit-area])))
+
+(defn- validate-studio-candidate
+  [source instances]
+  (let [compiled (facet-material/compile-source anatomy-material/spec source)
+        subjects (mapv :instance/id instances)
+        _ (doseq [subject subjects] (rebuild-block! subject))
+        rendered
+        (mapv
+         (fn [subject]
+           (let [slot (ss/slot (scene-rt/store-snapshot) (block-vi subject))]
+             {:subject subject
+              :present? (some? slot)
+              :error? (true? (get-in slot [:tree :data :assembly/error]))
+              :w (get-in slot [:tree :bounds :w])
+              :h (get-in slot [:tree :bounds :h])}))
+         subjects)
+        render-pass?
+        (and (:valid? compiled)
+             (every? #(and (:present? %)
+                           (not (:error? %))
+                           (pos? (or (:w %) 0))
+                           (pos? (or (:h %) 0)))
+                     rendered))
+        focus-subject (:instance/id
+                       (some #(when (= :empty (:instance/shape %)) %) instances))
+        binding (focus-binding-row focus-subject)
+        type-probe
+        (when-let [bi (block-info focus-subject)]
+          (let [st (-> (ge/init "studio-validator")
+                       (ge/focus-block focus-subject
+                                       (or (truth-text focus-subject) "") 0))]
+            (ge/input st {:type :char :char "x"} bi (object-key*))))
+        focus-pass? (and focus-subject (map? binding))
+        type-pass? (some? (:envelope type-probe))
+        bound-pass? (= {:verb/name :focus/place-caret :verb/version 0}
+                       (:binding/verb binding))
+        interaction-pass? (and focus-pass? type-pass? bound-pass?)
+        checks [(result-row :check :candidate/build (:valid? compiled)
+                            {:compiled? (:valid? compiled)})
+                (result-row :check :render/invariants render-pass?
+                            {:subjects subjects :rendered rendered})
+                (result-row :check :interaction/invariants interaction-pass?
+                            {:focus-row? focus-pass?
+                             :type-envelope? type-pass?
+                             :bound-gesture? bound-pass?})]
+        flows [(result-row :flow :focus focus-pass?
+                           {:subject focus-subject
+                            :mechanism :focus/place-caret})
+               (result-row :flow :type type-pass?
+                           {:subject focus-subject
+                            :mechanism :block-edit-envelope})
+               (result-row :flow :bound-gesture bound-pass?
+                           {:subject focus-subject
+                            :gesture :pointer/tap})
+               (result-row :flow :render render-pass?
+                           {:subjects subjects :mechanism :assembly})
+               (result-row :flow :interaction interaction-pass?
+                           {:subjects subjects :mechanism :binding})]
+        pass? (and (every? #(= :pass (:check/result %)) checks)
+                   (every? #(= :pass (:flow/result %)) flows))]
+    {:tested-instances instances
+     :checks checks
+     :flows flows
+     :result (if pass? :pass :fail)
+     :actor {:actor/id "studio-validator" :actor/type :agent}
+     :time-ms (js/Date.now)}))
+
+(defn- accept-studio-draft! []
+  (let [subject (studio-ui/selected)
+        draft (studio-ui/draft subject)
+        candidate (when draft
+                    (studio-ui/promotable-candidate (:form draft)))
+        instances (validation-instances)]
+    (cond
+      (not= :candidate (:status candidate))
+      (studio-refused! "Preparing the component" candidate)
+
+      (nil? instances)
+      (studio-refused!
+       "Testing the component"
+       {:reason "The canvas needs an empty, a wrapped, and a marked or machine block"})
+
+      :else
+      (let [source (:source candidate)]
+        (studio-ui/set-prior-default! nil)
+        (studio-ui/set-status! "Testing on three real blocks")
+        (render-studio!)
+        (let [promoted
+              (post-studio! {:studio/op :promote :source source
+                             :expected-instances instances})
+              prepared
+              (.then
+               promoted
+               (fn [promotion]
+                 (if-not (:accepted? promotion)
+                   (studio-refused! "Preparing the component" promotion)
+                   (let [revision-id (:revision-id promotion)]
+                     ;; Reverse names the authoritative active revision read by
+                     ;; the promotion owner after any code-floor bootstrap;
+                     ;; the client never infers a recovery identity.
+                     (studio-ui/set-prior-default!
+                      (:prior-revision-id promotion))
+                     (studio-ui/preview-subjects! instances source)
+                     (doseq [{:instance/keys [id]} instances]
+                       (rebuild-block! id))
+                     (js/Promise.
+                      (fn [resolve _reject]
+                        (js/requestAnimationFrame
+                         (fn [_]
+                           ;; R2 — a throw HERE runs on a later frame, well
+                           ;; after this executor returned; it is NOT caught
+                           ;; by the Promise constructor and would otherwise
+                           ;; leave this promise pending forever with the
+                           ;; three tested instances rendering the candidate
+                           ;; permanently. Always resolve: a validation
+                           ;; failure becomes a nil report, which the existing
+                           ;; `activated` stage below already treats as a
+                           ;; refusal (and already clears the preview).
+                           (resolve
+                            (try
+                              {:revision-id revision-id
+                               :report (validate-studio-candidate
+                                        source instances)}
+                              (catch :default error
+                                {:revision-id revision-id
+                                 :report nil
+                                 :validation-error (str error)})))))))))))
+              reported
+              (.then
+               prepared
+               (fn [prepared]
+                 (if-not (:report prepared)
+                   prepared
+                   (.then
+                    (post-studio!
+                     {:studio/op :report
+                      :revision-id (:revision-id prepared)
+                      :report (:report prepared)})
+                    (fn [reported]
+                      (assoc prepared :reported reported))))))
+              activated
+              (.then
+               reported
+               (fn [{:keys [revision-id report reported] :as prepared}]
+                 (studio-ui/clear-preview-subjects! instances)
+                 (doseq [{:instance/keys [id]} instances]
+                   (rebuild-block! id))
+                 (cond
+                   (nil? report) prepared
+                   (not= :pass (:result report))
+                   (studio-refused! "Testing the component" report)
+                   (not (:accepted? reported))
+                   (studio-refused! "Saving the test" reported)
+                   :else
+                   (post-edn!
+                    "/api/matter-room/activate"
+                    {:master-id anatomy-material/master-id
+                     :revision-id revision-id
+                     :request-id (str (random-uuid))
+                     :time-ms (js/Date.now)
+                     :actor {:actor/id "studio" :actor/type :human}}))))
+              finished
+              (.then
+               activated
+               (fn [activated]
+                 (if-not (:accepted? activated)
+                   (studio-refused! "Accepting the component" activated)
+                   (.then
+                    (post-studio! {:studio/op :release
+                                   :subject-uid subject})
+                    (fn [released]
+                      (if-not (:accepted? released)
+                        (studio-refused! "Finishing the component" released)
+                        (do
+                          (studio-ui/accept-subject!
+                           subject (:source candidate) (:form candidate))
+                          (rebuild-block! subject)
+                          (render-studio!)
+                          activated)))))))]
+          (.catch
+           finished
+           (fn [error]
+             ;; R2 — a rejection ANYWHERE in this chain (network failure,
+             ;; unexpected shape) must not strand the preview either: the
+             ;; `activated` stage's cleanup never ran if the chain broke
+             ;; before it, so clear it here too.
+             (studio-ui/clear-preview-subjects! instances)
+             (doseq [{:instance/keys [id]} instances]
+               (rebuild-block! id))
+             (studio-refused! "Accepting the component"
+                              {:error (.-message error)}))))))))
+
+(defn- duplicate-studio-draft! []
+  (when-let [subject (studio-ui/selected)]
+    (when-let [draft (studio-ui/draft subject)]
+      (let [block (get-in @!world [:blocks subject])
+            text (or (truth-text subject) "")]
+        (post-birth!
+         {:block-id (str (random-uuid))
+          :text text
+          :pos {:x (+ (:x block) 36.0) :y (+ (:y block) 48.0)}
+          :on-acked
+          (fn [new-subject _]
+            (land-draft!
+             new-subject text
+             {:status :candidate :source (:source draft) :form (:form draft)
+              :op-receipts []}))})))))
+
+(defn- retune-studio-draft! []
+  (when-let [subject (studio-ui/selected)]
+    (when-let [form (:form (studio-ui/draft subject))]
+      (let [palette [[0.30 0.70 0.95 1.0]
+                     [0.94 0.55 0.28 1.0]
+                     [0.54 0.82 0.48 1.0]]
+            current (some (fn [part]
+                            (when (= :studio-frame (:part/id part))
+                              (get-in part [:part/props :border-color])))
+                          (:anatomy/parts form))
+            current-i (first (keep-indexed
+                              (fn [i color]
+                                (when (= color current) i))
+                              palette))
+            color (nth palette
+                       (if (some? current-i)
+                         (mod (inc current-i) (count palette))
+                         0))]
+        (settle-draft-candidate!
+         :settle subject (studio-ui/retune-candidate form color))))))
+
+(defn- put-back-studio-component! []
+  (if-let [prior (:prior-default (studio-ui/state))]
+    (-> (post-edn!
+         "/api/matter-room/rollback"
+         {:master-id anatomy-material/master-id
+          :revision-id prior
+          :request-id (str (random-uuid))
+          :time-ms (js/Date.now)
+          :actor {:actor/id "studio" :actor/type :human}})
+        (.then
+         (fn [result]
+           (if (:accepted? result)
+             (do (studio-ui/set-status! "Put back")
+                 (render-studio!)
+                 result)
+             (studio-refused! "Putting it back" result))))
+        (.catch
+         (fn [error]
+           (studio-refused! "Putting it back"
+                            {:error (.-message error)}))))
+    (studio-refused! "Putting it back" {:reason "Nothing has been accepted yet"})))
+
+(defn- studio-control-action!
+  [{:keys [studio/intent]} _ctx]
+  (case intent
+    :duplicate (duplicate-studio-draft!)
+    :retune (retune-studio-draft!)
+    :accept (accept-studio-draft!)
+    :put-back (put-back-studio-component!)
+    :details (js/console.info "[STUDIO] details" (clj->js (:details (studio-ui/state))))
+    nil)
+  true)
+
+(scene-rt/register-action! :studio/birth-draft studio-birth-action!)
+(scene-rt/register-action! :studio/resize-draft studio-resize-action!)
+(scene-rt/register-action! :studio/control studio-control-action!)
