+      (testing "the preview changes exactly one subject and preserves others by identity"
+        (studio-ui/record-draft! "du:selected" (:source candidate)
+                                 (:form candidate))
+        (let [selected (studio-ui/wears-for "du:selected" base)
+              other (studio-ui/wears-for "du:other" base)]
+          (is (not (identical? base selected)))
