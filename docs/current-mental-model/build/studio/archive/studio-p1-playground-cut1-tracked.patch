+(defn studio-gate-import-request
+  "Build the existing `:object-container/import-material` request that mints
+   one immutable, nil-report gate marker. The marker request is appended and
+   read back BEFORE its candidate request, closing the inter-request bypass."
+  ([spec candidate-revision-id candidate-content-sha256 expected-instances]
+   (studio-gate-import-request spec candidate-revision-id
+                               candidate-content-sha256 expected-instances {}))
+  ([spec candidate-revision-id candidate-content-sha256 expected-instances opts]
+   (let [master-id (master-id spec)
+         gate-id (studio-gate-container-id spec candidate-revision-id)
+         marker (studio/marker-form
+                 {:master-id master-id
+                  :candidate-revision-id candidate-revision-id
+                  :candidate-content-sha256 candidate-content-sha256
+                  :expected-instances expected-instances
+                  :report nil})
+         source (studio/canonical-source marker)
+         source-hash (oc/source-hash source)
+         source-ref (studio-gate-source-ref spec candidate-revision-id)
+         source-ref-key (oc/source-ref-key source-ref)
+         import-key (import-key spec source-hash)
+         request-id (or (:request/id opts)
+                        (:request-id opts)
+                        (str "studio-gate-marker:"
+                             (core/sha-256
+                              (str candidate-revision-id source-hash))))
+         time-ms (long (or (:time-ms opts) (core/now-ms)))
+         actor (normalize-actor (:actor opts) import-capabilities)
+         created-by (:actor/id actor)
+         event-id (str "evt:" master-id ":" request-id)
+         document-id (document-id spec)
+         revision-id (oc/import-revision-id master-id gate-id source-hash)
+         order-key (oc/fixed-width-order-key time-ms request-id)
+         ;; A unique source id keeps the marker queryable without changing its
+         ;; physical locality: the embedded `fm:<slug>` still extracts to the
+         ;; parent master partition.
+         source-id (str (oc/source-id-for-object-key master-id)
+                        ":studio-gate-"
+                        (subs (core/sha-256 (str candidate-revision-id)) 0 16))
+         anchor-id (oc/source-anchor-id gate-id)
+         source-row (oc/->SourceArtifactRow
+                     source-id source-ref source-hash :edn source document-id
+                     (long (count (.getBytes source "UTF-8")))
+                     time-ms created-by event-id)
+         version-row (oc/->SourceVersionRow
+                      source-ref-key source-ref source-hash source-id document-id
+                      master-id order-key time-ms event-id)
+         revision-row (oc/->RevisionRow
+                       revision-id gate-id nil source source-hash order-key
+                       time-ms created-by event-id)
+         container-row (oc/->ObjectContainerRow
+                        gate-id :text-block master-id :private
+                        source-id anchor-id nil document-id revision-id nil nil
+                        time-ms created-by event-id)
+         anchor-row (oc/->SourceAnchorRow
+                     anchor-id :object-container gate-id source-id source-ref
+                     source-hash 0 (count source) nil event-id)
+         payload {:object-key master-id
+                  :source-ref source-ref
+                  :source-hash source-hash
+                  :source-raw-text source
+                  :source-format :edn
+                  :source-artifacts [source-row]
+                  :object-containers [container-row]
