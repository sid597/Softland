  2590	        phys-w (Math/floor (* w dpr))
  2591	        phys-h (Math/floor (* h dpr))
  2592	        phys-half-w (Math/floor (* half-w dpr))
  2593	        ;; Scratch buffer for comparison camera (avoid mutating camera-floats twice for same buffer)
  2594	        comp-floats (js/Float32Array. 6)]
  2595	    ;; Update both cameras — each sees half-width viewport
  2596	    (update-camera device (:camera-uniform-buffer primary-sys) camera-floats pan-x pan-y 1.0 half-w h)
  2597	    (update-camera device (:camera-uniform-buffer comparison-sys) comp-floats pan-x pan-y 1.0 half-w h)
  2598	
  2599	    (let [encoder (.createCommandEncoder device)
  2600	          swap-texture (.getCurrentTexture context)
  2601	          swap-view (.createView swap-texture)
  2602	          pass (.beginRenderPass encoder
  2603	                 (clj->js {:colorAttachments [{:view swap-view
  2604	                                               :clearValue {:r 0.06 :g 0.06 :b 0.06 :a 1.0}
  2605	                                               :loadOp "clear"
  2606	                                               :storeOp "store"}]}))]
  2607	
  2608	      ;; Left half — primary backend
  2609	      (.setViewport pass 0 0 phys-half-w phys-h 0 1)
  2610	      (when (and primary-sys (> (:num-instances primary-sys) 0))
  2611	        (.setPipeline pass (:pipeline primary-sys))
  2612	        (.setBindGroup pass 0 (:bind-group primary-sys))
  2613	        (.setVertexBuffer pass 0 (:instance-buffer primary-sys))
  2614	        (.draw pass 6 (:num-instances primary-sys) 0 0))
  2615	
  2616	      ;; Right half — comparison backend
  2617	      (.setViewport pass phys-half-w 0 (- phys-w phys-half-w) phys-h 0 1)
  2618	      (when (and comparison-sys (> (:num-instances comparison-sys) 0))
  2619	        (.setPipeline pass (:pipeline comparison-sys))
  2620	        (.setBindGroup pass 0 (:bind-group comparison-sys))
  2621	        (.setVertexBuffer pass 0 (:instance-buffer comparison-sys))
  2622	        (.draw pass 6 (:num-instances comparison-sys) 0 0))
