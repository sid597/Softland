  2755	    (assoc paint :sub-draws
  2756	           (mapv (fn [{:keys [clip container offset count]}]
  2757	                   {:clip clip :container container
  2758	                    :buffer (:buffer paint)
  2759	                    :instance-count count
  2760	                    :first-instance (+ base-offset offset)
  2761	                    :first-vertex (:first-vertex paint 0)
  2762	                    :vertex-count (:vertex-count paint)})
  2763	                 (contiguous-state-runs clip-rows)))))
