   309	    (.setPipeline pass pipeline)
   310	    (.setBindGroup pass 0 bind-group)
   311	    (.setVertexBuffer pass 0 buffer)
   312	    (.draw pass vertex-count 1 first-vertex 0)
   313	    (:entry/id entry)))
