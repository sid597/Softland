  2765	(defn image-entries
  2766	  "Mint exactly one image tape entry per (vi, :images).  Its ordered sub-draw
  2767	   vector is the explicit binding indirection; no texture grouping may reorder
  2768	   the stamped op stream (IMAGE-ATOM T1/T13)."
  2769	  [{:keys [store-frame image-system]}]
  2770	  (if-not (and image-system store-frame)
  2771	    []
  2772	    (let [prepared @(:!prepared-images image-system)
  2773	          pool (:pool image-system)
  2774	          buffer (:buffer @pool)
  2775	          pipeline (:pipeline image-system)]
  2776	      (loop [vis (:ordered-vis store-frame)
  2777	             offset 0
  2778	             entries []]
  2779	        (if-let [vi (first vis)]
  2780	          (let [instance-count (get-in store-frame
  2781	                                       [:ops-count-by-vi vi :images] 0)
  2782	                next-offset (+ offset instance-count)
  2783	                slot-ops (subvec prepared offset next-offset)
  2784	                source-order (get-in store-frame [:order-by-vi vi])
  2785	                entry-id [:frame/store vi :images]
  2786	                order (frame-order (or (:stratum source-order) :world)
  2787	                                   25 entry-id (:stack-path source-order) 3)
  2788	                sub-draws
  2789	                (mapv (fn [{:keys [first-instance instance-count ops]}]
  2790	                        {:bind-group (:image/bind-group (first ops))
  2791	                         :buffer buffer
  2792	                         :instance-count instance-count
  2793	                         :first-instance (+ offset first-instance)})
  2794	                      (image-material/contiguous-binding-runs slot-ops))
  2795	                entries (cond-> entries
  2796	                          (pos? instance-count)
  2797	                          (conj (frame-entry
  2798	                                 entry-id :render.family/image order
  2799	                                 {:pipeline pipeline :sub-draws sub-draws}
  2800	                                 {:geometry :image-quad :owner vi
  2801	                                  :boundary :half-open :hit-slop 0.0})))]
  2802	            (recur (next vis) next-offset entries))
  2803	          entries)))))
