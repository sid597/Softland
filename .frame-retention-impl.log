  2850	(defn image-entries
  2851	  "Mint exactly one image tape entry per (vi, :images).  Its ordered sub-draw
  2852	   vector is the explicit binding indirection; no texture grouping may reorder
  2853	   the stamped op stream (IMAGE-ATOM T1/T13)."
  2854	  [{:keys [store-frame image-system]}]
