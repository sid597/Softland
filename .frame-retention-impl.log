   326	                                  (:pulse-buffer chrome-system)
   327	                                  :reason :chrome-system-destroy)
   328	    (.destroy ^js (:pulse-buffer chrome-system)))
   329	  (reset! (:!prepared chrome-system) [])
   330	  (reset! (:!last-chromes chrome-system) ::destroyed)

