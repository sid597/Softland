  2856	    []
  2857	    (let [prepared @(:!prepared-images image-system)]
  2858	      (loop [vis (:ordered-vis store-frame)
  2859	             offset 0
  2860	             entries []]
  2861	        (if-let [vi (first vis)]
  2862	          (let [instance-count (get-in store-frame
  2863	                                       [:ops-count-by-vi vi :images] 0)
  2864	                next-offset (+ offset instance-count)
  2865	                source-order (get-in store-frame [:order-by-vi vi])
  2866	                entry-id [:frame/store vi :images]
  2867	                order (frame-order (or (:stratum source-order) :world)
  2868	                                   25 entry-id (:stack-path source-order) 3)
  2869	                entries (cond-> entries
  2870	                          (pos? instance-count)
  2871	                          (conj (frame-entry
  2872	                                 entry-id :render.family/image order
  2873	                                 {:paint/source image-system
  2874	                                  :paint/source-type :image-system
  2875	                                  :op-offset offset
  2876	                                  :instance-count instance-count}
  2877	                                 {:geometry :image-quad :owner vi
  2878	                                  :boundary :half-open :hit-slop 0.0})))]
  2879	            (recur (next vis) next-offset entries))
  2880	          entries)))))
