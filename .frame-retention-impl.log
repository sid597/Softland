  3375	    (let [batch (compile-frame-tape frame)
  3376	          maintained (into [] (map val) arrangement)
  3377	          same? (= maintained (:entries batch))
  3378	          prior (or (aget js/globalThis "__softland_frame_tape_twin_receipt")
  3379	                    #js {:frames 0 :divergences 0})
  3380	          receipt #js {:frames (inc (or (aget prior "frames") 0))
  3381	                       :divergences (+ (or (aget prior "divergences") 0)
  3382	                                       (if same? 0 1))
  3383	                       :lastFrame (:frame-idx frame)}]
  3384	      (aset js/globalThis "__softland_frame_tape_twin_receipt" receipt)
  3385	      (when-not same?
  3386	        (js/console.error "[FRAME-TAPE-TWIN/DIVERGENCE]"
  3387	                          (clj->js {:frame (:frame-idx frame)
  3388	                                    :maintained (mapv :entry/id maintained)
  3389	                                    :batch (mapv :entry/id (:entries batch))}))
  3390	        (throw (ex-info "Maintained frame arrangement diverged from batch oracle"
  3391	                        {:frame (:frame-idx frame)}))))))
