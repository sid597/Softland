   281	              rows (subvec @(:!prepared chrome-system) op-offset next-op-offset)
   282	              vertex-count (reduce + (map :vertex-count rows))
   283	              first-vertex (or (:first-vertex (first rows)) 0)
   284	              entry-id [:frame/store vi :chromes]
   285	              source-order (get-in store-frame [:order-by-vi vi])
