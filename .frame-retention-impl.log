  2805	(defn- pool-entry [entry-id family-id order pool-info]
  2806	  (when (and pool-info (pos? (:draw-count pool-info)))
  2807	    (frame-entry entry-id family-id order
  2808	                 (gpu-paint (:pipeline pool-info)
  2809	                            (:bind-group pool-info)
  2810	                            (:buffer pool-info)
  2811	                            (:draw-count pool-info)
  2812	                            0))))
