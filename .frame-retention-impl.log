+                   (update :composite-uploads + composite-uploads)
+                   (assoc :last-prepare
+                          {:regions (count regions) :closed closed
+                           :dirty (into {}
+                                        (map (fn [[id row]]
+                                               [id (:dirty-by-role row)]))
+                                        next)
+                           :composite-uploads composite-uploads})))))
+    @(:!receipt system)))
