  2823	(defn prepare-image-frame!
  2824	  "Identity-gated image pool write.  This is called only from draw-frame!'s
  2825	   existing encode window; the registered producer below is a pure read of the
  2826	   prepared vector (IMAGE-ATOM T10)."
  2827	  [image-system images]
  2828	  (let [images (or images [])
  2829	        !last-images (:!last-images image-system)
  2830	        prepare-key {:images images :resources @(:!resources image-system)}]
  2831	    (if (and (map? @(:!last-prepare-key image-system))
  2832	             (frame-inputs/inputs-same? (keys prepare-key)
  2833	                                        @(:!last-prepare-key image-system)
  2834	                                        prepare-key))
  2835	      {:identity-changed? false :writes 0
  2836	       :instances (count @(:!prepared-images image-system))}
  2837	      (let [prepared (mapv #(resolve-image-op image-system %) images)
  2838	            writes (buffer-pool/batch-update-pool! (:pool image-system)
  2839	                                                   prepared)]
  2840	        (reset! !last-images images)
  2841	        (reset! (:!last-prepare-key image-system) prepare-key)
  2842	        (reset! (:!prepared-images image-system) prepared)
  2843	        (swap! (:!receipt image-system) assoc
  2844	               :frame-write {:identity-changed? true
  2845	                             :writes writes :instances (count prepared)})
  2846	        (publish-image-receipt! image-system)
  2847	        {:identity-changed? true :writes writes
  2848	         :instances (count prepared)}))))
