  3328	(defn produce-frame-entries [frame]
  3329	  (let [fams #js []
  3330	        out (into []
  3331	                  (mapcat (fn [[family-id registration]]
  3332	                            (let [t0 (js/performance.now)
  3333	                                  entries ((:produce registration) frame)
  3334	                                  dt (- (js/performance.now) t0)]
  3335	                              (when (> dt 2)
  3336	                                (.push fams (str (name family-id) ":" (.toFixed dt 1))))
  3337	                              entries)))
