  3290	(def ^:private frame-contract-registry
  3291	  (let [executor-families (set (keys frame-family-registry))
  3292	        admitted-families (set scene-tape/family-ids)]
  3293	    (when-not (= admitted-families executor-families)
  3294	      (throw (ex-info "Frame executor registrations must exactly cover admitted families"
  3295	                      {:admitted admitted-families
  3296	                       :executors executor-families})))
  3297	    (when-let [nil-contracts
  3298	               (seq (keep (fn [[family-id registration]]
  3299	                            (when (nil? (:contract registration)) family-id))
  3300	                          frame-family-registry))]
  3301	      (throw (ex-info "Frame executor registration has no declarative contract"
  3302	                      {:families (vec nil-contracts)})))
  3303	    (into {}
  3304	          (map (fn [[family-id registration]]
  3305	                 [family-id (:contract registration)]))
