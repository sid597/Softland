  2743	  (loop [remaining rows offset 0 result []]
  2744	    (if-let [row (first remaining)]
  2745	      (let [same (take-while #(= row %) remaining)
  2746	            n (count same)]
  2747	        (recur (drop n remaining) (+ offset n)
  2748	               (conj result {:clip (:clip row) :container (:container row)
  2749	                             :offset offset :count n})))
  2750	      result)))
