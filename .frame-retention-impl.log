  2786	(defn- inset-resource-uv [resource-uv crop-uv]
  2787	  (let [[resource-u0 resource-v0 resource-u1 resource-v1] resource-uv
  2788	        [crop-u0 crop-v0 crop-u1 crop-v1] crop-uv
  2789	        du (- resource-u1 resource-u0)
  2790	        dv (- resource-v1 resource-v0)]
  2791	    [(+ resource-u0 (* crop-u0 du))
  2792	     (+ resource-v0 (* crop-v0 dv))
  2793	     (+ resource-u0 (* crop-u1 du))
  2794	     (+ resource-v0 (* crop-v1 dv))]))
