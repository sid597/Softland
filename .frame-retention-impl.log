  2814	(defn- store-pool-entries
  2815	  [store-frame pool-info count-key family-id part-rank pickable? base-offset]
  2816	  (loop [vis (:ordered-vis store-frame)
  2817	         offset (or base-offset 0)
  2818	         entries []]
  2819	    (if-let [vi (first vis)]
  2820	      (let [instance-count (get-in store-frame [:ops-count-by-vi vi count-key] 0)
  2821	            source-order (get-in store-frame [:order-by-vi vi])
  2822	            entry-id [:frame/store vi count-key]
  2823	            order (frame-order (or (:stratum source-order) :world)
  2824	                               25 entry-id (:stack-path source-order) part-rank)
  2825	            clip-rows (when (= :rects count-key)
  2826	                        (get-in store-frame [:rect-clips-by-vi vi]))
  2827	            paint (when pool-info
  2828	                    (cond-> (gpu-paint (:pipeline pool-info)
  2829	                                      (:bind-group pool-info)
  2830	                                      (:buffer pool-info)
  2831	                                      instance-count offset)
  2832	                      (seq clip-rows)
  2833	                      (add-instance-clip-runs clip-rows offset)))
  2834	            entries (cond-> entries
  2835	                      (and pool-info (pos? instance-count))
  2836	                      (conj (frame-entry
  2837	                             entry-id family-id order
  2838	                             paint
  2839	                             (if pickable?
  2840	                               {:geometry :rect-tree-bounds :owner vi}
  2841	                               :none))))]
  2842	        (recur (next vis) (+ offset instance-count) entries))
  2843	      entries)))
