  1865	(defn update-shadows [^js device shadow-system shadows]
  1866	  (let [n (count shadows)
  1867	        floats-per-shadow 21 ;; 20 + container u32 (scene-substrate P2)
  1868	        data (js/Float32Array. (* n floats-per-shadow))
  1869	        u32-view (js/Uint32Array. (.-buffer data))
  1870	        required-bytes (.-byteLength data)
  1871	        current-buffer (:instance-buffer shadow-system)
  1872	        current-size (.-size ^js current-buffer)
  1873	        needs-resize? (> required-bytes current-size)
  1874	        new-size (max required-bytes (* n shadow-stride))
  1875	        new-buffer (if needs-resize?
  1876	                     (.createBuffer device (clj->js {:size new-size
  1877	                                                     :usage (bit-or js/GPUBufferUsage.VERTEX
  1878	                                                                    js/GPUBufferUsage.COPY_DST)}))
  1879	                     current-buffer)]
  1880	    (when needs-resize?
  1881	      (gpu-budget/replace-buffer! (:gpu-tracker shadow-system) current-buffer new-buffer (:gpu-label shadow-system)
  1882	                                  new-size
  1883	                                  :active-bytes (* n shadow-stride)
  1884	                                  :reason :shadow-resize)
  1885	      (.destroy ^js current-buffer))

