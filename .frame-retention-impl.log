  2765	(defn- text-clip-runs [geo line-clips]
  2766	  (let [offsets (:line-offsets geo)
  2767	        line-count (count offsets)
  2768	        rows (mapv (fn [line-index]
  2769	                     (let [start (nth offsets line-index)
  2770	                           end (if (< (inc line-index) line-count)
  2771	                                 (nth offsets (inc line-index))
  2772	                                 (:num-instances geo))
  2773	                           clip-row (first (filter :clip
  2774	                                                   (get line-clips line-index)))]
  2775	                       {:clip (:clip clip-row) :container (:container clip-row)
  2776	                        :offset start :count (- end start)}))
  2777	                   (range line-count))]
  2778	    (->> rows
  2779	         (partition-by #(select-keys % [:clip :container]))
  2780	         (mapv (fn [group]
  2781	                 (let [first-row (first group)]
  2782	                   {:clip (:clip first-row) :container (:container first-row)
  2783	                    :offset (:offset first-row)
  2784	                    :count (reduce + (map :count group))}))))))
