  2967	             (when (and geo (= family-id (text-system-family geo)))
  2968	               (let [entry (system-entry
  2969	                            [:frame/slot-text vi] family-id
  2970	                            (frame-order (or (:stratum source-order) :world)
  2971	                                         25 [:frame/slot-text vi]
