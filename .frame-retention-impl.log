  3031	(defn- execute-gpu-batch! [^js pass entry]
  3032	  (let [{:keys [pipeline bind-group buffer vertex-count instance-count
  3033	                first-vertex first-instance scissor sub-draws attachment-size]}
  3034	        (:paint entry)]
  3035	    (.setPipeline pass pipeline)
  3036	    (when bind-group (.setBindGroup pass 0 bind-group))
  3037	    (if (seq sub-draws)
  3038	      (doseq [{:keys [clip buffer vertex-count instance-count first-vertex
  3039	                      first-instance]} sub-draws]
  3040	        (when (compositor-gpu/apply-scissor! pass clip attachment-size)
  3041	          (when buffer (.setVertexBuffer pass 0 buffer))
  3042	          (.draw pass vertex-count instance-count first-vertex first-instance)))
  3043	      (do
  3044	        (when (compositor-gpu/apply-scissor!
  3045	               pass
  3046	               (when scissor {:x (nth scissor 0) :y (nth scissor 1)
  3047	                              :w (nth scissor 2) :h (nth scissor 3)})
  3048	               attachment-size)
  3049	          (when buffer (.setVertexBuffer pass 0 buffer))
  3050	          (.draw pass vertex-count instance-count first-vertex first-instance))))
  3051	    (:entry/id entry)))
  3052	
  3053	(defn execute-image-batch!
  3054	  "Family-owned sub-draw walker.  Bind changes are walked in the op-derived
  3055	   vector's order; the central tape executor remains family-blind (T1)."
  3056	  [^js pass entry]
  3057	  (let [{:keys [pipeline sub-draws]} (:paint entry)]
  3058	    (.setPipeline pass pipeline)
  3059	    (doseq [{:keys [bind-group buffer instance-count first-instance]}
  3060	            sub-draws]
  3061	      (.setBindGroup pass 0 bind-group)
  3062	      (.setVertexBuffer pass 0 buffer)
  3063	      (.draw pass 6 instance-count 0 first-instance))
  3064	    (:entry/id entry)))
