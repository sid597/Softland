  3371	(defn- frame-tape-twin-check! [frame arrangement]
  3372	  (when (true? (aget js/globalThis "__softland_frame_tape_twin_check"))
  3373	    ;; SEAM-STEP1 T6: the batch compiler stays executable as the independent
