   318	(defn destroy-chrome-system! [chrome-system]
   319	  (when-let [buffer @(:!buffer chrome-system)]
   320	    (gpu-budget/destroy-resource! (:gpu-tracker chrome-system) buffer
   321	                                  :reason :chrome-system-destroy)
