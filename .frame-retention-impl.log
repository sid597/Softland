  2644	    :material/id entry-id
  2645	    :material/revision 0
  2646	    :instance/id entry-id
  2647	    :family/id family-id
  2648	    :order order
  2649	    :paint paint
  2650	    :pick pick
  2651	    :visibility {:visible? true :clip :frame-shared}}))
