  3101	(defn- execute-gpu-batch! [^js pass entry]
  3102	  (let [{:keys [pipeline bind-group buffer vertex-count instance-count
  3103	                first-vertex first-instance scissor sub-draws attachment-size]}
  3104	        (resolve-gpu-paint (:paint entry))]
  3105	    (.setPipeline pass pipeline)
  3106	    (when bind-group (.setBindGroup pass 0 bind-group))
  3107	    (if (seq sub-draws)
  3108	      (doseq [{:keys [clip buffer vertex-count instance-count first-vertex
  3109	                      first-instance]} sub-draws]
  3110	        (when (compositor-gpu/apply-scissor! pass clip attachment-size)
  3111	          (when buffer (.setVertexBuffer pass 0 buffer))
  3112	          (.draw pass vertex-count instance-count first-vertex first-instance)))
  3113	      (do
  3114	        (when (compositor-gpu/apply-scissor!
  3115	               pass
  3116	               (when scissor {:x (nth scissor 0) :y (nth scissor 1)
  3117	                              :w (nth scissor 2) :h (nth scissor 3)})
  3118	               attachment-size)
  3119	          (when buffer (.setVertexBuffer pass 0 buffer))
  3120	          (.draw pass vertex-count instance-count first-vertex first-instance))))
  3121	    (:entry/id entry)))
  3122	
  3123	(defn resolve-image-paint [paint]
  3124	  (let [image-system (:paint/source paint)
  3125	        offset (:op-offset paint)
  3126	        instance-count (:instance-count paint)
  3127	        prepared @(:!prepared-images image-system)
  3128	        slot-ops (subvec prepared offset (+ offset instance-count))
  3129	        buffer (:buffer @(:pool image-system))]
  3130	    {:pipeline (:pipeline image-system)
  3131	     :sub-draws
  3132	     (mapv (fn [{:keys [first-instance instance-count ops]}]
  3133	             {:bind-group (:image/bind-group (first ops))
  3134	              :buffer buffer
  3135	              :instance-count instance-count
  3136	              :first-instance (+ offset first-instance)})
  3137	           (image-material/contiguous-binding-runs slot-ops))}))
  3138	
  3139	(defn execute-image-batch!
  3140	  "Family-owned sub-draw walker.  Bind changes are walked in the op-derived
  3141	  vector's order; the central tape executor remains family-blind (T1)."
  3142	  [^js pass entry]
  3143	  (let [{:keys [pipeline sub-draws]} (resolve-image-paint (:paint entry))]
  3144	    (.setPipeline pass pipeline)
  3145	    (doseq [{:keys [bind-group buffer instance-count first-instance]}
  3146	            sub-draws]
  3147	      (.setBindGroup pass 0 bind-group)
  3148	      (.setVertexBuffer pass 0 buffer)
  3149	      (.draw pass 6 instance-count 0 first-instance))
  3150	    (:entry/id entry)))

