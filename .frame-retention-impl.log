  2653	(defn- gpu-paint [pipeline bind-group buffer instance-count first-instance]
  2654	  {:pipeline pipeline
  2655	   :bind-group bind-group
  2656	   :buffer buffer
  2657	   :vertex-count 6
  2658	   :instance-count instance-count
  2659	   :first-vertex 0
  2660	   :first-instance (or first-instance 0)})
  2661	
  2662	(defn- contiguous-state-runs [rows]
  2663	  (loop [remaining rows offset 0 result []]
  2664	    (if-let [row (first remaining)]
  2665	      (let [same (take-while #(= row %) remaining)
  2666	            n (count same)]
  2667	        (recur (drop n remaining) (+ offset n)
  2668	               (conj result {:clip (:clip row) :container (:container row)
  2669	                             :offset offset :count n})))
  2670	      result)))
  2671	
  2672	(defn- add-instance-clip-runs [paint clip-rows base-offset]
  2673	  (if-not (some :clip clip-rows)
  2674	    paint
  2675	    (assoc paint :sub-draws
  2676	           (mapv (fn [{:keys [clip container offset count]}]
  2677	                   {:clip clip :container container
  2678	                    :buffer (:buffer paint)
  2679	                    :instance-count count
  2680	                    :first-instance (+ base-offset offset)
  2681	                    :first-vertex (:first-vertex paint 0)
  2682	                    :vertex-count (:vertex-count paint)})
  2683	                 (contiguous-state-runs clip-rows)))))
  2684	
  2685	(defn- text-clip-runs [geo line-clips]
  2686	  (let [offsets (:line-offsets geo)
  2687	        line-count (count offsets)
  2688	        rows (mapv (fn [line-index]
  2689	                     (let [start (nth offsets line-index)
  2690	                           end (if (< (inc line-index) line-count)
  2691	                                 (nth offsets (inc line-index))
  2692	                                 (:num-instances geo))
  2693	                           clip-row (first (filter :clip
  2694	                                                   (get line-clips line-index)))]
  2695	                       {:clip (:clip clip-row) :container (:container clip-row)
  2696	                        :offset start :count (- end start)}))
  2697	                   (range line-count))]
  2698	    (->> rows
  2699	         (partition-by #(select-keys % [:clip :container]))
  2700	         (mapv (fn [group]
  2701	                 (let [first-row (first group)]
  2702	                   {:clip (:clip first-row) :container (:container first-row)
  2703	                    :offset (:offset first-row)
  2704	                    :count (reduce + (map :count group))}))))))
  2705	
  2706	(defn- inset-resource-uv [resource-uv crop-uv]
  2707	  (let [[resource-u0 resource-v0 resource-u1 resource-v1] resource-uv
  2708	        [crop-u0 crop-v0 crop-u1 crop-v1] crop-uv
  2709	        du (- resource-u1 resource-u0)
  2710	        dv (- resource-v1 resource-v0)]
  2711	    [(+ resource-u0 (* crop-u0 du))
  2712	     (+ resource-v0 (* crop-v0 dv))
  2713	     (+ resource-u0 (* crop-u1 du))
  2714	     (+ resource-v0 (* crop-v1 dv))]))
  2715	
  2716	(defn- resolve-image-op [image-system image-op]
  2717	  (let [digest (:image/digest image-op)
  2718	        resource (get @(:!resources image-system) digest)
  2719	        prior-row (get-in @(:!receipt image-system) [:rows digest])
  2720	        resolved (or resource (:placeholder image-system))]
  2721	    (when-not resource
  2722	      ;; Missing resources are a deterministic material outcome.  The frame
  2723	      ;; never starts decode work and never silently drops an instance (T10).
  2724	      ;; A prior refusal or device-loss event keeps its causal status/history;
  2725	      ;; painting its placeholder must not relabel it as an unknown digest.
  2726	      (if prior-row
  2727	        (do
  2728	          (swap! (:!receipt image-system) assoc-in
  2729	                 [:rows digest :placeholder-rendered] true)
  2730	          (publish-image-receipt! image-system))
  2731	        (record-image-receipt! image-system digest :unavailable
  2732	                               :unresolvable-digest
  2733	                               {:placeholder true
  2734	                                :placeholder-rendered true})))
  2735	    (assoc image-op
  2736	           :image/binding-key (:binding-key resolved)
  2737	           :image/bind-group (:bind-group resolved)
  2738	           :image/resolved-uv
  2739	           (if resource
  2740	             (inset-resource-uv (:uv resolved) (:image/uv image-op))
  2741	             (:uv resolved)))))
  2742	
  2743	(defn prepare-image-frame!
  2744	  "Identity-gated image pool write.  This is called only from draw-frame!'s
  2745	   existing encode window; the registered producer below is a pure read of the
  2746	   prepared vector (IMAGE-ATOM T10)."
  2747	  [image-system images]
  2748	  (let [images (or images [])
  2749	        !last-images (:!last-images image-system)]
  2750	    (if (identical? images @!last-images)
  2751	      {:identity-changed? false :writes 0
  2752	       :instances (count @(:!prepared-images image-system))}
  2753	      (let [prepared (mapv #(resolve-image-op image-system %) images)
  2754	            writes (buffer-pool/batch-update-pool! (:pool image-system)
  2755	                                                   prepared)]
  2756	        (reset! !last-images images)
  2757	        (reset! (:!prepared-images image-system) prepared)
  2758	        (swap! (:!receipt image-system) assoc
  2759	               :frame-write {:identity-changed? true
  2760	                             :writes writes :instances (count prepared)})
  2761	        (publish-image-receipt! image-system)
  2762	        {:identity-changed? true :writes writes
  2763	         :instances (count prepared)}))))
