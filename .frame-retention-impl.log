  2796	(defn- resolve-image-op [image-system image-op]
  2797	  (let [digest (:image/digest image-op)
  2798	        resource (get @(:!resources image-system) digest)
  2799	        prior-row (get-in @(:!receipt image-system) [:rows digest])
  2800	        resolved (or resource (:placeholder image-system))]
  2801	    (when-not resource
  2802	      ;; Missing resources are a deterministic material outcome.  The frame
  2803	      ;; never starts decode work and never silently drops an instance (T10).
  2804	      ;; A prior refusal or device-loss event keeps its causal status/history;
  2805	      ;; painting its placeholder must not relabel it as an unknown digest.
  2806	      (if prior-row
  2807	        (do
  2808	          (swap! (:!receipt image-system) assoc-in
  2809	                 [:rows digest :placeholder-rendered] true)
  2810	          (publish-image-receipt! image-system))
  2811	        (record-image-receipt! image-system digest :unavailable
  2812	                               :unresolvable-digest
  2813	                               {:placeholder true
  2814	                                :placeholder-rendered true})))
  2815	    (assoc image-op
  2816	           :image/binding-key (:binding-key resolved)
  2817	           :image/bind-group (:bind-group resolved)
  2818	           :image/resolved-uv
  2819	           (if resource
  2820	             (inset-resource-uv (:uv resolved) (:image/uv image-op))
  2821	             (:uv resolved)))))
