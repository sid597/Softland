  2583	(defn draw-comparison-frame!
  2584	  "Draw two text systems side-by-side: left = primary backend, right = comparison backend.
  2585	   Each half gets screen_dimensions = (w/2, h) so text renders at full scale.
  2586	   Rects, shadows, chrome are skipped — this is a pure text rendering comparison."
