  3343	(defn update-frame-arrangement [arrangement frame]
  3344	  (let [entries (produce-frame-entries frame)
  3345	        ;; SEAM-STEP1 T12: order invalidation comes from the produced semantic
  3346	        ;; id/token pairs. No execution-clock or revision stamp is an ancestor.
  3347	        produced-pairs (into #{} (map (juxt :entry/id :order)) entries)
  3348	        arrangement
  3349	        (reduce (fn [ordered entry]
  3350	                  (if (contains? produced-pairs [(:entry/id entry) (:order entry)])
  3351	                    ordered
  3352	                    (scene-tape/ordered-remove ordered entry)))
  3353	                arrangement
  3354	                (vals arrangement))]
  3355	    (reduce
  3356	     (fn [ordered entry]
  3357	       (let [key (scene-tape/entry-key entry)]
  3358	         (if (contains? ordered key)
  3359	           ;; Same semantic order: only rebind the per-frame GPU payload.
  3360	           (assoc ordered key entry)
  3361	           (scene-tape/ordered-insert frame-contract-registry ordered entry))))
  3362	     arrangement
  3363	     entries)))
