  2631	   (frame-order stratum rank stable-tie nested-stack-path 0))
  2632	  ([stratum rank stable-tie nested-stack-path part-rank]
  2633	   {:stratum stratum
  2634	    :pass-class :direct
  2635	    :stack-path (into [[:frame/root rank rank]] (or nested-stack-path []))
  2636	    :part-rank part-rank
  2637	    :stable-tie stable-tie}))
