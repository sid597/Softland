#!/usr/bin/env python3
"""Launch/build/check the isolated Softland-in-Softland product.

Owns .inland-runtime processes, configuration and durable storage, plus target
build outputs. Uses exact PID/cwd markers before stopping processes, read from
/proc on Linux and from ps/lsof on macOS. Distribution files are copied from
INLAND_RAMA_RELEASE, else the first of /mnt/data/rama and ~/rama/rama-1.6.0 that
exists; existing cluster data is never used. The deployed module is the rig's
store (src/proposal/rig-2026-09-25, rig.store.module/Store), whose records are
thrown away. See ../src-inland/README.md for architecture and
../test-inland/README.md for checks.
"""
import json
import os
from pathlib import Path
import shutil
import signal
import socket
import subprocess
import sys
import time
import zipfile

ROOT = Path(__file__).resolve().parent.parent
RUNTIME = ROOT / '.inland-runtime'
RELEASE = RUNTIME / 'release'
PUBLIC = ROOT / 'target/inland/public'
RIG = ROOT / 'src/proposal/rig-2026-09-25'
MODULE = 'rig.store.module/Store'
RAMA_RELEASES = [Path('/mnt/data/rama'), Path.home() / 'rama/rama-1.6.0']


def run(args, cwd=ROOT):
    """Run an argument vector in cwd; inherit output and raise on nonzero exit."""
    subprocess.run(args, cwd=cwd, check=True)


def listening(port):
    """Return whether loopback accepts a TCP connection; does not prove ownership."""
    with socket.socket() as sock:
        sock.settimeout(.3)
        return sock.connect_ex(('127.0.0.1', port)) == 0


def await_port(port, timeout=100):
    """Wait up to timeout seconds for TCP reachability or raise. Currently unused."""
    end = time.monotonic() + timeout
    while not listening(port):
        if time.monotonic() > end:
            raise RuntimeError(f'Port {port} did not open; inspect {RUNTIME}/logs')
        time.sleep(1)


def rama_release():
    """Return the Rama distribution folder: INLAND_RAMA_RELEASE, else the first
    of RAMA_RELEASES holding a `rama` launcher. Raises naming what was tried."""
    if os.environ.get('INLAND_RAMA_RELEASE'):
        return Path(os.environ['INLAND_RAMA_RELEASE'])
    for candidate in RAMA_RELEASES:
        if (candidate / 'rama').exists():
            return candidate
    raise RuntimeError('No Rama distribution: set INLAND_RAMA_RELEASE or unpack one at '
                       + ' or '.join(str(c) for c in RAMA_RELEASES))


def setup():
    """Create isolated directories/config; copy distribution binaries if absent.

    Reads distribution files only. Writes all cluster paths under this runtime;
    does not inspect credentials, licenses, existing data or shared configuration."""
    RUNTIME.mkdir(exist_ok=True)
    (RUNTIME / 'logs').mkdir(exist_ok=True)
    if not (RELEASE / 'rama').exists():
        source = rama_release()
        RELEASE.mkdir(exist_ok=True)
        # Distribution files only; no source data, config, tokens or licenses.
        for name in ['rama', 'rama.jar', 'log4j2.properties', 'LICENSE.txt']:
            shutil.copy2(source / name, RELEASE / name)
        shutil.copytree(source / 'lib', RELEASE / 'lib', dirs_exist_ok=True)
    (RELEASE / 'logs').mkdir(exist_ok=True)
    (RELEASE / 'rama.yaml').write_text(f'''zookeeper.servers: ["localhost"]
zookeeper.port: 2217
zookeeper.root: "inland-electric"
conductor.host: "localhost"
conductor.port: 1997
cluster.ui.port: 8917
supervisor.port.range: [35970, 36970]
local.dir: "{RUNTIME}/data"
license.dir: "{RUNTIME}/licenses"
conductor.child.opts: "-Xmx512m"
supervisor.child.opts: "-Xmx256m"
cluster.metadata: "Softland in Softland — isolated experiment"
''')
    (RUNTIME / 'worker.yaml').write_text('worker.child.opts: "-Xmx1024m -Xss16m"\n')


def process_info(pid):
    """Return (cwd, command line) of a live pid, or None when it is gone.

    Linux reads /proc; macOS, which has none, asks ps for the command line and
    lsof for the working directory. The cwd is None when it cannot be read."""
    proc = Path(f'/proc/{pid}')
    if proc.exists():
        try:
            return (proc / 'cwd').resolve(), (proc / 'cmdline').read_bytes().decode().replace('\0', ' ')
        except (FileNotFoundError, PermissionError, ProcessLookupError):
            return None
    if Path('/proc').exists():
        return None
    args = subprocess.run(['ps', '-o', 'command=', '-p', str(pid)], capture_output=True, text=True).stdout.strip()
    if not args:
        return None
    out = subprocess.run(['lsof', '-a', '-p', str(pid), '-d', 'cwd', '-Fn'], capture_output=True, text=True).stdout
    cwd = next((line[1:] for line in out.splitlines() if line.startswith('n')), None)
    return (Path(cwd).resolve() if cwd else None), args


def start(name, args, cwd, port):
    """Start one named process group or retain a listener with matching PID custody.

    Log output and retain its pid; wait for port reachability or fail with log path.
    Port reachability alone is not a protocol/readiness or socket-owner proof."""
    pidfile = RUNTIME / f'{name}.pid'
    if listening(port):
        if not owned_pid(name):
            raise RuntimeError(f'Port {port} is occupied by an unowned process')
        print(f'{name} already listening on {port}', flush=True)
        return
    with (RUNTIME / f'logs/{name}.log').open('ab') as log:
        process = subprocess.Popen(args, cwd=cwd, stdout=log, stderr=log,
                                   start_new_session=True)
    pidfile.write_text(str(process.pid))
    end = time.monotonic() + 100
    while not listening(port):
        if process.poll() is not None:
            raise RuntimeError(f'{name} exited; inspect {RUNTIME}/logs/{name}.log and {RELEASE}/logs')
        if time.monotonic() > end:
            raise RuntimeError(f'{name} did not open {port}; inspect {RUNTIME}/logs')
        time.sleep(1)
    print(f'{name} listening on {port}', flush=True)


def cluster():
    """Set up and start isolated ZooKeeper, conductor and supervisor in order."""
    setup()
    start('zookeeper', ['./rama', 'devZookeeper'], RELEASE, 2217)
    start('conductor', ['./rama', 'conductor'], RELEASE, 1997)
    start('supervisor', ['./rama', 'supervisor'], RELEASE, 35970)


def module_jar():
    """Package the rig's store source into a module jar, with the classes of
    the one library it uses that the cluster does not provide (rama-helpers).

    Every .clj/.cljc under the rig's src, at its namespace path; the helpers'
    classes from the jar the rig's own classpath names. Returns the target
    path; source-only packaging does not compile or deploy it."""
    target = ROOT / 'target/inland/store.jar'
    target.parent.mkdir(parents=True, exist_ok=True)
    source = RIG / 'src'
    classpath = subprocess.check_output(['clojure', '-Spath'], cwd=RIG, text=True).strip().split(os.pathsep)
    helpers = [Path(p) for p in classpath if Path(p).name.startswith('rama-helpers-') and p.endswith('.jar')]
    if not helpers:
        raise RuntimeError('The rig classpath names no rama-helpers jar')
    with zipfile.ZipFile(target, 'w', zipfile.ZIP_DEFLATED) as jar:
        for path in source.rglob('*'):
            if path.is_file() and path.suffix in ['.clj', '.cljc']:
                jar.write(path, str(path.relative_to(source)))
        with zipfile.ZipFile(helpers[0]) as lib:
            for entry in lib.namelist():
                if entry.endswith('.class'):
                    jar.writestr(entry, lib.read(entry))
    return target


def module_status():
    """Read isolated Rama moduleStatus and parse its last output line as JSON."""
    result = subprocess.check_output(['./rama', 'moduleStatus', MODULE], cwd=RELEASE, text=True)
    return json.loads(result.strip().splitlines()[-1])


def deploy(action='launch'):
    """Launch/update module and wait for a new active matching read/write target.

    Ensures cluster first; records installation only after observed RUNNING state.
    Uses two tasks, two threads and one worker. Timeout leaves runtime intact."""
    cluster()
    before = module_status().get('readTargetId') if action == 'update' else None
    run(['./rama', 'deploy', '--action', action, '--jar', str(module_jar()),
         '--module', MODULE, '--tasks', '2', '--threads', '2', '--workers', '1',
         '--configOverrides', str(RUNTIME / 'worker.yaml')], RELEASE)
    deadline = time.monotonic() + 120
    while True:
        status = module_status()
        if (status.get('moduleState') == 'RUNNING'
                and status.get('readTargetId') == status.get('appendTargetId')
                and status.get('readTargetId') != before):
            break
        if time.monotonic() > deadline:
            raise RuntimeError('The submitted module has not become the active read/write instance')
        time.sleep(1)
    (RUNTIME / 'module-installed').write_text(MODULE + '\n')


def build():
    """Install the browser's npm packages if absent, copy product/font assets and
    compile the Electric browser release.

    Mutates node_modules and target output only; compiler dependency and
    activation must exist."""
    if not (ROOT / 'node_modules/harfbuzzjs').exists():
        run(['npm', 'install', '--omit=dev', '--no-audit', '--no-fund'])
    PUBLIC.mkdir(parents=True, exist_ok=True)
    shutil.copytree(ROOT / 'resources/inland', PUBLIC, dirs_exist_ok=True)
    (PUBLIC / 'fonts').mkdir(exist_ok=True)
    for name in ['manifest.json', 'harfbuzz-0.10.3.wasm',
                 'ubuntu_sans_variable.ttf', 'noto_sans_regular.ttf', 'dejavu_sans_mono.ttf',
                 'ubuntu_sans_variable_slug_meta.json', 'ubuntu_sans_variable_slug_curve.bin',
                 'ubuntu_sans_variable_slug_band.bin', 'dejavu_sans_mono_slug_meta.json',
                 'dejavu_sans_mono_slug_curve.bin', 'dejavu_sans_mono_slug_band.bin']:
        shutil.copy2(ROOT / 'resources/public/fonts' / name, PUBLIC / 'fonts' / name)
    run(['clojure', '-M:inland', '-m', 'shadow.cljs.devtools.cli', 'release', 'inland'])


def serve():
    """Start loopback Electric app; optionally enable explicit test controls.

    Requires deployed cluster and built assets. Does not restart a running app
    merely because flags changed; stop-app first when changing control mode."""
    setup()
    if '--test-controls' in sys.argv:
        os.environ['INLAND_TEST_CONTROLS'] = '1'
    start('app', ['clojure', '-M:inland', '-m', 'softland.inland.server'], ROOT, 8127)
    print('Open http://localhost:8127', flush=True)


def owned_pid(name):
    """Return a live recorded pid only if its cwd and expected command marker match.

    Missing/dead pid returns None; mismatched custody raises before any signal."""
    pidfile = RUNTIME / f'{name}.pid'
    if pidfile.exists():
        pid = int(pidfile.read_text())
        info = process_info(pid)
        if info is None:
            return None
        cwd, args = info
        marker = {'app':'softland.inland.server', 'conductor':'daemon.conductor',
                  'supervisor':'daemon.supervisor', 'zookeeper':'command.dev_zookeeper'}[name]
        if cwd is None or (cwd != ROOT and RUNTIME not in cwd.parents) or marker not in args:
            raise RuntimeError(f'PID {pid} is no longer owned by this launcher')
        return pid
    return None


def stop(name):
    """Signal the owned process group and retire its pid file.

    For app, wait up to 15 seconds for port closure; retain pid custody on timeout.
    Other processes receive SIGTERM without a separate exit confirmation."""
    pidfile = RUNTIME / f'{name}.pid'
    pid = owned_pid(name)
    if pid:
        try:
            os.killpg(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        if name == 'app':
            deadline = time.monotonic() + 15
            while listening(8127) and time.monotonic() < deadline:
                time.sleep(.2)
            if listening(8127):
                raise RuntimeError('App is still stopping; pid custody was retained')
    if pidfile.exists():
        pidfile.unlink()


def stop_workers():
    """Signal Rama worker processes matching both exact runtime cwd and main class.

    Handles supervisor-created worker groups; never uses a broad name-only kill."""
    # Supervisors may give workers their own process group. Match BOTH exact
    # runtime cwd and main class, never another experiment or the shared cluster.
    if Path('/proc').exists():
        pids = [int(p.name) for p in Path('/proc').glob('[0-9]*')]
    else:
        out = subprocess.run(['pgrep', '-f', 'rpl.rama.distributed.daemon.worker'],
                             capture_output=True, text=True).stdout
        pids = [int(line) for line in out.split()]
    for pid in pids:
        info = process_info(pid)
        if info is None:
            continue
        cwd, args = info
        if cwd == RELEASE and 'rpl.rama.distributed.daemon.worker' in args.split():
            try:
                os.kill(pid, signal.SIGTERM)
            except ProcessLookupError:
                pass


def main():
    """Dispatch launcher command; default prints usage.

    up deploys/builds/restarts; down stops owned processes and preserves data.
    check uses fresh IPC; verify drives browsers and makes a real provider call."""
    command = sys.argv[1] if len(sys.argv) > 1 else 'help'
    if command == 'setup': setup()
    elif command == 'cluster': cluster()
    elif command == 'deploy': deploy(sys.argv[2] if len(sys.argv) > 2 else 'launch')
    elif command == 'up':
        cluster()
        deploy('update' if (RUNTIME / 'module-installed').exists() else 'launch')
        build()
        if owned_pid('app'): stop('app')
        serve()
    elif command == 'seed':
        run(['clojure', '-J-Xss16m', '-M:inland', '-m', 'softland.inland.operator', 'seed'])
    elif command == 'forget':
        run(['clojure', '-J-Xss16m', '-M:inland', '-m', 'softland.inland.operator', 'forget', sys.argv[2]])
    elif command == 'build': build()
    elif command == 'serve': serve()
    elif command == 'stop-app': stop('app')
    elif command == 'down':
        stop('app')
        stop('supervisor')
        stop_workers()
        for name in ['conductor', 'zookeeper']: stop(name)
    elif command == 'check':
        run(['clojure', '-J-Xss16m', '-M:inland', '-m', 'softland.inland.scenes-test'])
    elif command == 'verify':
        run(['node', 'test-inland/browser.mjs'])
    elif command == 'status':
        print(json.dumps({str(p): listening(p) for p in [2217, 1997, 35970, 8127]}))
    else:
        print('bin/inland up [--test-controls] | seed | forget <person> | setup | cluster | deploy [launch|update] | build | serve [--test-controls] | stop-app | down | check | verify | status')


if __name__ == '__main__':
    main()
