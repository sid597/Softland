;; Model-UXR subjects config (SPEC §5). Loaded by runner.clj (replaces the
;; embedded default-config WHOLESALE — every key the runner reads must be here).
;;
;; SUBJECT IDENTITY RULE: the :id encodes model × quant × served-context.
;; A q4 and a q8 of the same model are DIFFERENT subjects; the same file
;; served at a different context window is a DIFFERENT subject. Never reuse
;; an id across serving configs — score rows key on it.
;;
;; LOCAL SERVING (llama.cpp llama-server, ROCm build 8262, 2×RX 7900 XTX):
;; one model per process, one PORT per subject — distinct ports make a
;; wrong-model call fail loudly (connection refused) instead of silently
;; querying whatever is on a shared port. Start the subject's server before
;; running it; the runner is sequential, so one server at a time is fine.
;;
;;   nemotron-30b-a3b-q8-32k  (smoked 2026-07-05: gen 100 tok/s, prefill
;;                             4553 tok/s @5k neutral prompt, ~36GB split):
;;     llama-server -m /home/sid/projects/models/nvidia_Nemotron-3-Nano-30B-A3B-Q8_0.gguf \
;;                  --port 8091 -ngl 99 -c 32768 --host 127.0.0.1
;;   qwen3-32b-q8-16k         (smoked 2026-07-05: gen 21 tok/s, ~41GB split):
;;     llama-server -m /home/sid/projects/models/Qwen3-32B-Q8_0.gguf \
;;                  --port 8092 -ngl 99 -c 16384 --host 127.0.0.1
;;
;; Keys come from ENV VARS ONLY (SPEC §5 hard rule; never env.clj). Local
;; llama-server ignores auth unless started with --api-key, so
;; LOCAL_LLM_API_KEY=dummy satisfies the runner's env check.
;;
;; POOL CANDIDATES ON DISK, NOT YET SUBJECTS (add only after a smoke pass,
;; with their own quant+context ids):
;;   /home/sid/projects/models/mistralai_Devstral-Small-2-24B-Instruct-2512-Q8_0.gguf
;;   /home/sid/projects/models/allenai_Olmo-3.1-32B-Think-Q8_0.gguf
;;   gemma3-27b arm: NOT on disk (2026-07-05) — pull needs Sid's word (~17GB Q4_K_M).
;;
;; Frontier + grader model ids are OPERATOR-SET at the freeze gate (gate (c)
;; is the frontier-token budget confirmation — model choice rides with it).

{:snapshot-dir "snapshots/current"
 :questions    "docs/current-mental-model/build/model-uxr/QUESTIONS.md"
 :tokenizer    :ws-proxy               ; frozen with the bank (SPEC §2)

 :grader {:provider :anthropic
          :model    "<set-me-at-freeze-gate>"
          :key-env  "ANTHROPIC_API_KEY"}

 :subjects
 [;; --- local pool (validated by neutral smoke, 2026-07-05) ---------------
  {:id        "nemotron-30b-a3b-q8-32k"
   :provider  :openai-compatible
   :endpoint  "http://127.0.0.1:8091/v1"
   :model     "nvidia_Nemotron-3-Nano-30B-A3B-Q8_0.gguf"
   :key-env   "LOCAL_LLM_API_KEY"
   :max-tokens 4096
   :temperature 0}

  {:id        "qwen3-32b-q8-16k"
   :provider  :openai-compatible
   :endpoint  "http://127.0.0.1:8092/v1"
   :model     "Qwen3-32B-Q8_0.gguf"
   :key-env   "LOCAL_LLM_API_KEY"
   :max-tokens 4096
   :temperature 0}

  ;; --- frontier (SPEC §5; id gets the concrete model at the freeze gate) --
  {:id        "frontier-anthropic"
   :provider  :anthropic
   :endpoint  "https://api.anthropic.com"
   :model     "<set-me-at-freeze-gate>"
   :key-env   "ANTHROPIC_API_KEY"
   :max-tokens 4096
   :temperature 0}]

 ;; Ablations copied from runner default-ablations (this file REPLACES the
 ;; embedded config; ABLATIONS.md is the registered source).
 :ablations
 {:A0 {:include ["CLAUDE.md" "docs/current-mental-model/**"
                 "docs/sessions/next-prompt.md" "vision/LOG.md" "relations/**"]
       :exclude ["bundles/**"]}
  :A1 {:include ["CLAUDE.md" "docs/current-mental-model/**"
                 "docs/sessions/next-prompt.md" "vision/LOG.md" "relations/**"]
       :exclude ["bundles/**" "docs/current-mental-model/decisions.md"]}
  :A2 {:include ["CLAUDE.md" "docs/current-mental-model/**"
                 "vision/LOG.md" "relations/**"]
       :exclude ["bundles/**" "docs/sessions/next-prompt.md"]}
  :A3 {:include ["CLAUDE.md" "docs/current-mental-model/**"
                 "docs/sessions/next-prompt.md" "vision/LOG.md"]
       :exclude ["bundles/**" "relations/**"]}
  :A4 {:include ["bundles/**"]
       :exclude []}}

 :run {:seed 0 :repeats 1 :human-audit-frac 0.15 :output "runs/"}}
