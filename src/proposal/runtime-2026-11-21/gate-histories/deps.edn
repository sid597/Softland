{:paths ["src" "../../../../src-store"]
 :mvn/repos {"nexus-releases" {:url "https://nexus.redplanetlabs.com/repository/maven-public-releases"}}
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        org.clojure/test.check {:mvn/version "1.1.0"}}
 :aliases {:run {:main-opts ["-m" "gate-histories.run"]
                 :jvm-opts ["-Xss16m"]}
           :record {:main-opts ["-m" "gate-histories.record"]
                    :jvm-opts ["-Xss16m" "-Xmx6g"]}
           ;; the smallest histories through the store's module on an
           ;; in-process cluster: Rama, as the store's module alias has it
           :cluster {:extra-deps {com.rpl/rama {:mvn/version "1.6.0"}}
                     :main-opts ["-m" "gate-histories.cluster"]
                     :jvm-opts ["-Xss16m" "-Xmx4g"]}}}
