 ;; ------------------------------------------------- the pushes, and their sharing
 
+(defonce trace-t0 (System/nanoTime))
+(def trace-lock (Object.))
+(defn trace-layer? [source] (boolean (re-find #"j15" (str (:layer source)))))
+(defn short-source [source] [(:table source) (:layer source) (:path source)])
+(def trace-queue (java.util.concurrent.ConcurrentLinkedQueue.))
+(defmacro trc [& xs]
+  `(.add ^java.util.concurrent.ConcurrentLinkedQueue trace-queue
+         [(System/nanoTime) (.getName (Thread/currentThread)) (fn [] [~@xs])]))
+(defn trace-dump! []
+  (locking trace-lock
+    (doseq [[t thread thunk] (sort-by first (vec trace-queue))]
+      (println (apply print-str "TRACE" (format "%.3f" (/ (- t trace-t0) 1e6)) thread (thunk))))
+    (.clear ^java.util.concurrent.ConcurrentLinkedQueue trace-queue)
+    (flush)))
+(defn erin-read? [read] (boolean (re-find #"erin" (str (:asker (:query read))))))
+(defn- place-brief [m] (into (sorted-map-by #(compare (str %1) (str %2))) (map (fn [[p a]] [p ((juxt :holds :value :layer) a)])) m))
+(defn tell-summary [change]
+  (cond (:anew change) [:anew :places (place-brief (:places (:anew change))) :left-out (:left-out (:anew change)) :orders (:orders (:anew change))]
+        (:changed change) [:changed (place-brief (:changed change))]
+        :else [:other change]))
+(defonce anew-with-n-1 (promise))
+(defn hold-on? [] (Boolean/getBoolean "softland.hold"))
+(defn hold-kind [source]
+  (when (re-find #"j15n" (str (:layer source)))
+    (cond (= :facts-by-value (:table source)) :order
+          (and (= :row (first (:path source))) (re-find #":f-2 :parent" (str (second (:path source))))) :f-2)))
+
 (declare on-callback)
 
