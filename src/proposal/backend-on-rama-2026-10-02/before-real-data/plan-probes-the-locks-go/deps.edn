;; The probe of the plan of `the-locks-go`: the run of ruling 19's condition, and the
;; counts that the plan's bounds rest on. Not code of the store.
;;
;; `src-store` is on the paths for the store's pure namespaces only: the one text, the
;; digest, the act, and the function by which the microbatch depot places a thing
;; (`softland.store.gate.batch/first-entity`, pure code). No namespace of the store's
;; module, door or read path is required here.
;;
;; Run from this folder. A run that starts a cluster takes the build's lock first:
;;   flock ../runs/cluster.lock clojure -M:digests
;;   clojure -M:sizes                              (pure: no cluster, no lock)
{:paths ["src" "../../../../../src-store"]
 :mvn/repos {"nexus-releases" {:url "https://nexus.redplanetlabs.com/repository/maven-public-releases"}}
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        com.rpl/rama        {:mvn/version "1.6.0"}}
 :aliases {;; ruling 19's condition: the digest of a thing as a client appended it against the
           ;; digest of the thing as a topology takes it off the depot, and as a client reads
           ;; the log back
           :digests {:jvm-opts ["-Xss16m" "-Xmx4g"] :main-opts ["-m" "probe.digests"]}
           ;; the counts of the plan's section D: texts, depths, times. Pure
           :sizes   {:jvm-opts ["-Xss16m" "-Xmx4g"] :main-opts ["-m" "probe.sizes"]}
           ;; a thing that is nested very deep, through a client's append. Run last and alone
           :deep    {:jvm-opts ["-Xss16m" "-Xmx4g"] :main-opts ["-m" "probe.deep"]}}}
