;; The probe of the plan of the part `answers-in-a-log`. It requires nothing of the store's tree.
;; Run from this folder, one at a time, each behind the build's lock:
;;   flock ../runs/cluster.lock clojure -M:stream
;;   flock ../runs/cluster.lock clojure -M:batch
;;   flock ../runs/cluster.lock clojure -M:one
{:paths ["src"]
 :mvn/repos {"nexus-releases" {:url "https://nexus.redplanetlabs.com/repository/maven-public-releases"}}
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        com.rpl/rama        {:mvn/version "1.6.0"}}
 :aliases {;; S: the streaming gate's keeping, as the plan has it: write, commit boundary, append
           :stream {:jvm-opts ["-Xss16m" "-Xmx4g"] :main-opts ["-m" "probe.stream" "fail"]}
           ;; O: Rama's setting topology.stream.max.executing.per.task at 1, set from outside a module's own code
           :one    {:jvm-opts ["-Xss16m" "-Xmx4g"] :main-opts ["-m" "probe.stream" "one"]}
           ;; M: the microbatch gate's keeping, as the plan has it: the run that closes a batch appends
           :batch  {:jvm-opts ["-Xss16m" "-Xmx4g"] :main-opts ["-m" "probe.batch"]}
           ;; the earlier form of M: each task keeps and appends its own
           :batch-each-task {:jvm-opts ["-Xss16m" "-Xmx4g"] :main-opts ["-m" "probe.batch-each-task"]}}}
