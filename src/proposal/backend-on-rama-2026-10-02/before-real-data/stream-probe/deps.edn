{:paths ["src"]
 :mvn/repos {"nexus-releases" {:url "https://nexus.redplanetlabs.com/repository/maven-public-releases"}}
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        com.rpl/rama        {:mvn/version "1.6.0"}}
 :aliases {:jvm   {:jvm-opts ["-Xss16m" "-Xmx4g"]}
           ;; question 1: a source record that fails after its event appended
           :fail  {:jvm-opts ["-Xss16m" "-Xmx4g"] :main-opts ["-m" "probe.fail"]}
           ;; question 3, and the failures that are no throw: the timeout, a worker started again
           :order {:jvm-opts ["-Xss16m" "-Xmx4g"] :main-opts ["-m" "probe.order"]}
           ;; question 2: the row and the record, seen together or not
           :seen  {:jvm-opts ["-Xss16m" "-Xmx4g"] :main-opts ["-m" "probe.seen"]}
           ;; question 4: what the append costs an event
           :cost  {:jvm-opts ["-Xss16m" "-Xmx4g"] :main-opts ["-m" "probe.cost"]}
           ;; question 5: a client reads a depot back
           :read  {:jvm-opts ["-Xss16m" "-Xmx4g"] :main-opts ["-m" "probe.read"]}
           ;; the skill's deadlock warning: :ack to a depot that a stream topology consumes
           :dead  {:jvm-opts ["-Xss16m" "-Xmx4g"] :main-opts ["-m" "probe.dead"]}}}
