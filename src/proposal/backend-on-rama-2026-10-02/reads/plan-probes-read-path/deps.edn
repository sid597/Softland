{:paths ["src"]
 :mvn/repos {"nexus-releases" {:url "https://nexus.redplanetlabs.com/repository/maven-public-releases"}}
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        com.rpl/rama        {:mvn/version "1.6.0"}}
 :aliases {;; T: what a client of Rama 1.6.0 can do that the plan of the read
           ;; path rests on. A probe: its module is no code of the store.
           ;; From this folder:   clojure -M:tasks
           ;; From the repository root, with no cd:
           ;;   clojure -Sdeps '{:aliases {:read-path-probe {:extra-paths ["src/proposal/backend-on-rama-2026-10-02/reads/plan-probes-read-path/src"]}}}' \
           ;;           -M:store-module:read-path-probe -m probe.tasks
           :tasks {:jvm-opts ["-Xss16m" "-Xmx4g"] :main-opts ["-m" "probe.tasks"]}
           ;; U: how a read of a run can be bounded in the path itself.
           ;; From this folder:   clojure -M:runs
           :runs  {:jvm-opts ["-Xss16m" "-Xmx4g"] :main-opts ["-m" "probe.runs"]}}}
