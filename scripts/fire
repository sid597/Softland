#!/usr/bin/env python3
"""Read-only 1-screen dashboard of active Softland proposal tracks and loop state."""
import pathlib, re, subprocess

ROOT = pathlib.Path(__file__).resolve().parent.parent
PROP = ROOT / "src" / "proposal"
LOOPS = ["0a", "0b", "0c", "0d", "1", "2a", "2b", "3", "4", "5"]

def parse_edn(path: pathlib.Path) -> dict:
    txt = path.read_text()
    return {k: v for k, v in re.findall(r':([a-z-]+)\s+"([^"]*)"', txt)}

def parse_kv(path: pathlib.Path) -> dict:
    out = {}
    for line in path.read_text().splitlines():
        if m := re.match(r"^([a-z]+):\s*(.+)$", line.strip()):
            out[m.group(1)] = m.group(2).strip()
    return out

head = subprocess.run(["git", "-C", str(ROOT), "rev-parse", "--short", "HEAD"],
                      capture_output=True, text=True).stdout.strip()
print(f"=== SOFTLAND FIRE (HEAD {head}) ===")
tracks = [parse_edn(p) | {"_dir": p.parent} for p in sorted(PROP.glob("*/FIRE.edn"))]
for t in tracks:
    st = f"dir:{t['status-dir']}/" if "status-dir" in t else t.get("status", "?")
    print(f"TRACK  {t['track']:<34} [{st}] {t.get('summary', '')}")
    if t.get("waiting-on"):
        print(f"       waiting on: {t['waiting-on']}")

sdir = PROP / "permissions-2026-11-27" / "state"
active_next = None
for lid in LOOPS:
    f = sdir / f"loop-{lid}.md"
    if f.exists():
        kv = parse_kv(f)
        st_val = kv.get("status", "?")
        st_short = "DONE" if st_val.startswith("DONE") else st_val
        print(f"  loop-{lid:<2}  {st_short:<22} commit={kv.get('commit','none')[:18]:<18} verified={kv.get('verified','not run')[:72]}")
        if not st_val.startswith("DONE") and not active_next:
            active_next = kv.get("next")
    else:
        print(f"  loop-{lid:<2}  PENDING")
# What each track waits on and does next is its own FIRE.edn's to say: no line
# of this script names a fix or a loop, so none goes stale here.
if active_next:
    print(f"NEXT   permissions-2026-11-27: {active_next}")
for t in tracks:
    if t.get("next"):
        print(f"NEXT   {t['track']}: {t['next']}")
