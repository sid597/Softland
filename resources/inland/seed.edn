:notes] []]], :definition "note-row", :bindings {:file [:get :file], :first [:get :first], :last [:get :last]}} {:id "earlier-bg", :kind :path, :shape :rect, :box [90 700 160 30], :fill nil, :stroke [0.7 0.67 0.82 0.2], :radius 6, :order 40} {:id "earlier-label", :kind :text, :text "Earlier lines", :box [102 720 140], :size 12, :color [0.94 0.94 0.98 1]} {:id "earlier", :kind :hit, :box [90 700 160 30], :event {:kind :line-page, :value -1}} {:id "later-bg", :kind :path, :shape :rect, :box [262 700 160 30], :fill nil, :stroke [0.7 0.67 0.82 0.2], :radius 6, :order 40} {:id "later-label", :kind :text, :text "Later lines", :box [274 720 140], :size 12, :color [0.94 0.94 0.98 1]} {:id "later", :kind :hit, :box [262 700 160 30], :event {:kind :line-page, :value 1}}]]}, :pattern {:demand :view, :reads []}}

{:name "file-row", :body {:steps [{:out :x, :op :value, :args [:+ 40 [:* [:get :at] 118]]}], :return [{:id "bg", :kind :path, :shape :rect, :box [[:get :x] 96 112 30], :fill [:if [:= [:get :item] [:get :open]] [0.5 0.51 0.88 0.25] nil], :stroke [0.7 0.67 0.82 0.2], :radius 6, :order 40} {:id "label", :kind :text, :text [:or [:lookup [:get :labels] [:get :item]] [:get :item]], :box [[:+ [:get :x] 8] 116 100 16], :size 11, :color [0.94 0.94 0.98 1]} {:id "open", :kind :hit, :box [[:get :x] 96 112 30], :event {:kind :open-file, :subject [:get :item]}}]}}

