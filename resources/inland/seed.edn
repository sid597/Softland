, :size 12, :color [0.94 0.94 0.98 1]} {:id "add", :kind :hit, :box [1300 292 96 38], :event {:kind :add-member}} {:id "note-title", :kind :text, :text "A note on the selection, for the pair", :box [1040 362 356], :size 13, :color [0.94 0.94 0.98 1]} {:id "note-on", :kind :text, :text [:str "on: " [:or [:get :selected :label] "nothing selected"]], :box [1040 382 356], :size 11, :color [0.65 0.63 0.73 1]} {:id "note", :kind :input, :cell "note", :box [1040 390 356 70], :label "Note", :size 11} {:id "names-title", :kind :text, :text "It names (the note's grammar makes them its subjects):", :box [1040 478 356], :size 11, :color [0.65 0.63 0.73 1]} {:id "names", :kind :input, :cell "names", :box [1040 486 248 38], :label "Person named", :size 11} {:id "note-bg", :kind :path, :shape :rect, :box [1300 486 96 38], :fill nil, :stroke [0.7 0.67 0.82 0.2], :radius 6, :order 40} {:id "note-label", :kind :text, :text "Write", :box [1312 509 76], :size 12, :color [0.94 0.94 0.98 1]} {:id "write-note", :kind :hit, :box [1300 486 96 38], :event {:kind :note}} {:id "marks-title", :kind :text, :text "What stood on something that changed", :box [1040 568 356], :size 13, :color [0.94 0.94 0.98 1]} {:id "marks-cells", :kind :text, :text [:if [:empty? [:get :cells]] "Your selection and pins stand on what is current." [:str [:if [:get :sel-mark] [:str "Your selection stood on an older " [:get :sel-mark :on-thing] ". "] ""] [:if [:get :pin-mark] [:str "Your pin stood on an older " [:get :pin-mark :on-thing] "."] ""]]], :box [1040 592 356], :size 11, :color [:if [:empty? [:get :cells]] [0.65 0.63 0.73 1] [1 0.62 0.52 1]]} {:id "marks-things", :kind :text, :text [:if [:empty? [:get :things]] "None of your records stands on an older fact." [:str "Your records that stood on an older fact: " [:join ", " [:get :things]]]], :box [1040 634 356], :size 11, :color [:if [:empty? [:get :things]] [0.65 0.63 0.73 1] [1 0.62 0.52 1]]}]}, :pattern {:demand :view, :reads [{:session "tab", :equals "pair"}]