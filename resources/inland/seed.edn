{:name "walk-step" :body {:steps [{:out :head :op :value :args [:first [:get :state :frontier]]} {:out :seen :op :value :args [:contains? [:get :state :visited] [:get :head]]} {:out :edges :op :read :args {:name [:get :head] :attr :neighbors} :when [:and [:get :head] [:not [:get :seen]]]}] :return {:done [:empty? [:get :state :frontier]] :result [:get :state :visited] :state {:frontier [:if [:get :head] [:if [:get :seen] [:rest [:get :state :frontier]] [:concat [:rest [:get :state :frontier]] [:or [:get :edges] []]]] []] :visited [:if [:or [:not [:get :head]] [:get :seen]] [:get :state :visited] [:conj [:get :state :visited] [:get :head]]]}}}}

