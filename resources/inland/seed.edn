{:name "function-or-section", :label "Select the function, or the section, that contains the line", :body {:steps [{:out :reading, :op :read, :args {:name [:get :subject :file], :attr :material/file}} {:out :at, :op :value, :args [:- [:get :subject :line] 1]} {:out :si, :op :value, :args [:nth [:get :reading :section-by-line] [:get :at]]} {:out :section, :op :value, :args [:nth [:get :reading :sections] [:get :si]], :when [:get :si]} {:out :ui, :op :value, :args [:nth [:get :reading :unit-by-line] [:get :at]]} {:out :unit, :op :value, :args [:nth [:get :reading :units] [:get :ui]], :when [:get :ui]} {:out :prose, :op :value, :args [:= [:get :reading :cut] :blocks]}], :return [:if [:and [:get :prose] [:get :section]] {:file [:get :subject :file], :from [:first [:get :section :lines]], :to [:nth [:get :section :lines] 1], :kind "section", :label [:str "§ " [:get :section :title] "  (lines " [:first [:get :section :lines]] "–" [:nth [:get :section :lines] 1] ")"]} [:if [:and [:not [:get :prose]] [:get :unit]] {:file [:get :subject :file], :from [:first [:get :unit :lines]], :to [:nth [:get :unit :lines] 1], :kind "function", :label [:str [:or [:get :unit :name] "form"] "  (lines " [:first [:get :unit :lines]] "–" [:nth [:get :unit :lines] 1] ")"]} {:file [:get :subject :file], :from [:get :subject :line], :to [:get :subject :line], :kind "line", :label [:str "line " [:get :subject :line]]}]]}}

