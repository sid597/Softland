{
  "id": "pickup-brush@2",
  "what": "The coating-reading pickup brush. Four authored dabs on kA at t = .65, .70, .41, .65, in that order, at the merged revision G@2 with kA under kB. Each dab reads the composed coating at its point with the brush's own previous painting above the coating, mixes that sample into the carry by .25 (the carry starts opaque red), builds a disc of surface radius 8.75 mm, and paints the carry into the painting at opacity .5.",
  "support": {"id": "G", "revision": 2},
  "coating": {"order": ["kA", "kB"]},
  "painting": {
    "id": "pickup",
    "grid": [64, 32],
    "domain": [588.3185307179587, 194, 80, 30],
    "chart": "S0",
    "filter": "nearest",
    "initial": [0, 0, 0, 0]
  },
  "tool": {
    "curve": "kA/arc-AB",
    "pickup": 0.25,
    "radius": 8.75,
    "opacity": 0.5,
    "start": [1, 0, 0, 1]
  },
  "events": [
    {"id": "d1", "t": 0.65},
    {"id": "d2", "t": 0.7},
    {"id": "d3", "t": 0.41},
    {"id": "d4", "t": 0.65}
  ],
  "program": {
    "each": "events",
    "state": {
      "carry": "tool.start",
      "painting": "painting.initial"
    },
    "steps": [
      {"out": "at", "op": "curve-point", "curve": "tool.curve", "t": "event.t"},
      {"out": "read", "op": "read-surface", "support": "support", "point": "at", "layers": ["coating", "state.painting"], "order": "coating.order"},
      {"out": "mixed", "op": "mix", "a": "state.carry", "b": "read.color", "amount": "tool.pickup"},
      {"out": "disc", "op": "surface-region", "support": "support", "point": "at", "radius": "tool.radius", "distance": "surface"},
      {"out": "painted", "op": "paint", "painting": "state.painting", "region": "disc", "rgba": "mixed", "opacity": "tool.opacity"}
    ],
    "next": {"carry": "mixed", "painting": "painted"},
    "return": ["state.carry", "state.painting"]
  }
}
