(require '[clojure.java.io :as io] '[clojure.string :as str] '[clojure.test :as t])
(let [declaration (with-open [r (java.io.PushbackReader. (io/reader "test/app/test_runner.clj"))]
                    (loop []
                      (let [form (read r)]
                        (if (and (seq? form) (= 'def (first form)) (= 'pure-namespaces (second form)))
                          form (recur)))))
      names (filter #(str/starts-with? (str %) "app.client.") (second (nth declaration 2)))]
  (doseq [n names] (require n))
  (let [summary (apply t/run-tests names)]
    (prn {:surface :repository-client-pure :namespaces (count names) :summary summary})
    (System/exit (if (zero? (+ (:fail summary) (:error summary))) 0 1))))
RUNNER END

