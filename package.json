{
  "name": "softland",
  "version": "0.0.1",
  "description": "``` $ clj -M:dev -m dev",
  "main": "index.js",
  "scripts": {
    "build": "clj -M:dev -m dev",
    "verify:text-layout": "clj -M:test -e \"(require 'app.client.text.layout-test) (let [r (clojure.test/run-tests 'app.client.text.layout-test)] (System/exit (+ (:fail r) (:error r))))\" && node test/render_engine/verify_proportional_shaper.mjs && node test/render_engine/verify_text_layout_fence.mjs",
    "verify:render-engine": "npm run verify:text-layout && node test/render_engine/verify_instance_cut.mjs && clj -M:dev -m shadow.cljs.devtools.cli release render-verifier && node test/render_engine/run_verifier.mjs"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bidi-js": "1.0.3",
    "harfbuzzjs": "0.10.3",
    "shadow-cljs": "^2.20.1"
  },
  "devDependencies": {
    "karma": "6.4.0",
    "karma-chrome-launcher": "3.1.1",
    "karma-cljs-test": "0.1.0",
    "puppeteer": "15.2.0"
  }
}
